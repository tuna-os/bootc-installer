{
  "_comment": "Outcomes every resolver must reproduce. Inputs are the sibling files; 'name_override' is the BOOTC_INSTALLER_PRODUCT_NAME case. 'expect' covers the scalar keys; 'expect_copy' lists copy keys (file overrides, an explicit empty override, and untouched defaults); 'expect_assets' and 'expect_store_url' the rest.",
  "file_and_os_release": {
    "branding": "branding.json",
    "os_release": "os-release",
    "expect": {
      "name": "Marlin",
      "id": "exampleos",
      "vendor": "Example OS",
      "home_url": "https://example.org/",
      "docs_url": "https://docs.example.org/marlin",
      "support_url": "https://help.example.org/",
      "logo": "exampleos-logo",
      "default_hostname": "reef",
      "default_image": "ghcr.io/example/marlin:latest"
    },
    "expect_store_url": "https://store.example.org/",
    "expect_copy": {
      "confirm_button": "Onward",
      "confirm_subtitle": "\"Hold fast.\" — Someone",
      "done_subtitle": "",
      "welcome_title": "Welcome to {name}",
      "progress_title": "Installing {name}…"
    },
    "expect_assets": {
      "store_qr": "/usr/share/example/store-qr.svg",
      "welcome_image": ""
    }
  },
  "os_release_only": {
    "branding": null,
