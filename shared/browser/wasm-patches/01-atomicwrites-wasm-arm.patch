+// Added locally to answer one question: whether libcosmic's renderer builds
+// for wasm32 once cosmic-config stops being the thing that stops the build.
+// std::fs exists on wasm32-unknown-unknown and every call fails at runtime,
+// which is the honest behaviour for a target with no filesystem -- and is
+// fine here, because nothing writes config in a browser.
+#[cfg(target_family = "wasm")]
+mod imp {
+    use std::{fs, io, path};
+
+    pub fn replace_atomic(src: &path::Path, dst: &path::Path) -> io::Result<()> {
+        fs::rename(src, dst)
+    }
+
+    pub fn move_atomic(src: &path::Path, dst: &path::Path) -> io::Result<()> {
+        fs::rename(src, dst)
+    }
+}
