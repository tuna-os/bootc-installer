{
    "app-id": "org.bootcinstaller.Installer",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "bootc-installer",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=all",
        "--filesystem=host",
        "--talk-name=org.freedesktop.Flatpak",
        "--system-talk-name=org.freedesktop.login1",
        "--system-talk-name=org.freedesktop.PolicyKit1"
    ],
    "cleanup": [
        "/go"
    ],
    "build-options": {
        "env": {
            "PATH": "/app/go/bin:/usr/bin:/bin",
            "GOPATH": "/run/build/go-path",
            "GOCACHE": "/run/build/go-cache",
            "GONOSUMDB": "*",
            "GOFLAGS": "",
            "GOPROXY": "off"
        }
    },
    "modules": [
        {
            "name": "mutter-schemas",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm644 org.gnome.mutter.gschema.xml /app/share/glib-2.0/schemas/org.gnome.mutter.gschema.xml",
                "glib-compile-schemas /app/share/glib-2.0/schemas/"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "org.gnome.mutter.gschema.xml"
                }
            ]
        },
        "../shared/flatpak/go.json",
        {
            "name": "fisherman",
            "buildsystem": "simple",
            "build-commands": [
                "go build -C fisherman -o /app/bin/fisherman ./cmd/fisherman"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../fisherman"
                }
            ]
        },
        {
            "name": "blueprint-compiler",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://gitlab.gnome.org/GNOME/blueprint-compiler/-/archive/v0.16.0/blueprint-compiler-v0.16.0.tar.gz",
                    "sha256": "01feb8263fe7a450b0a9fed0fd54cf88947aaf00f86cc7da345f8b39a0e7bd30"
                }
            ]
        },
        {
            "name": "python3-segno",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"segno\" --no-build-isolation"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/d6/02/12c73fd423eb9577b97fc1924966b929eff7074ae6b2e15dd3d30cb9e4ae/segno-1.6.6-py3-none-any.whl",
                    "sha256": "28c7d081ed0cf935e0411293a465efd4d500704072cdb039778a2ab8736190c7"
                }
            ]
        },
        {
            "name": "bootc-installer",
            "buildsystem": "meson",
            "config-opts": [
                "-Dbuild-fisherman=false"
            ],
            "build-options": {
                "env": {
                    "PATH": "/app/bin:/usr/bin:/bin"
                }
            },
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                }
            ]
        },
        {
            "name": "polkit-action",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm644 data/polkit/org.bootcinstaller.Installer.policy /app/share/polkit-1/actions/org.bootcinstaller.Installer.policy"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                }
            ]
        }
    ]
}
