using Gtk 4.0;
using Adw 1;

template $BootcDefaultConnCheck: Adw.Bin {
  halign: fill;
  valign: fill;
  hexpand: true;

  ScrolledWindow {
    hscrollbar-policy: never;
    vexpand: true;
    hexpand: true;

    Adw.PreferencesPage {
      Adw.PreferencesGroup {
        $BootcPageHeader page_header {
          margin-top: 24;
          icon-name: "content-loading-symbolic";
          title: _("Checking Connection");
          subtitle: _("Please wait until the connection check is done");
        }
      }

      Adw.PreferencesGroup {
        Box {
          orientation: horizontal;
          halign: center;
          spacing: 12;

          Button btn_network_settings {
            label: _("Network settings");
            visible: false;

            styles [
              "pill",
              "suggested-action",
            ]
          }

          Button btn_recheck {
            label: "Check Again";
            visible: false;

            styles [
              "pill",
            ]
          }
        }
      }
    }
  }
}
