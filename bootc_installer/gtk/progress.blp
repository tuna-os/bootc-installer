using Gtk 4.0;
using Adw 1;

template $BootcProgress: Box {
  orientation: vertical;

  // The install video (or its fallback panel). Hidden until the install
  // starts: before that there is nothing to play, and an empty pane would
  // push the status to the bottom of the window.
  Box media_box {
    visible: false;
    vexpand: true;
    margin-start: 40;
    margin-end: 40;
    margin-top: 1;
    height-request: 320;
    orientation: vertical;

    Overlay {
      hexpand: true;
      vexpand: true;

      Adw.Clamp {
        maximum-size: 960;
        tightening-threshold: 720;
        hexpand: true;
        vexpand: true;
        valign: center;

        AspectFrame {
          ratio: 1.777778;
          obey-child: false;
          xalign: 0.5;
          yalign: 0.5;
          hexpand: true;
          vexpand: true;

          Gtk.Video install_video {
            hexpand: true;
            vexpand: true;
            autoplay: true;
            loop: true;

            styles [
              "card",
            ]
          }
        }
      }

      Box video_fallback_box {
        visible: false;
        orientation: vertical;
        valign: center;
        halign: center;
        margin-start: 32;
        margin-end: 32;
        margin-top: 32;
        margin-bottom: 32;
        width-request: 440;

        Box {
          orientation: vertical;
          spacing: 16;
          margin-start: 28;
          margin-end: 28;
          margin-top: 28;
          margin-bottom: 28;

          Picture fallback_dino {
            height-request: 120;
            content-fit: contain;
            can-shrink: true;
          }

          Label {
            label: _("Installation Video Coming Soon!");
            justify: center;
            wrap: true;

            styles [
              "title-4",
            ]
          }

          Label {
            label: _("Installation will continue normally. Feel free to browse around. Rawr.");
            justify: center;
            wrap: true;
            max-width-chars: 44;

            styles [
              "caption",
              "dim-label",
            ]
          }

          Separator {
            orientation: horizontal;
            margin-top: 4;
            margin-bottom: 4;

            styles [
              "dim-label",
            ]
          }

          Label lbl_store {
            label: _("Visit the store");
            justify: center;

            styles [
              "caption",
              "dim-label",
            ]
          }

          Picture fallback_store_qr {
            height-request: 160;
            width-request: 160;
            halign: center;
            content-fit: contain;
            can-shrink: true;
          }
        }

        styles [
          "card",
        ]
      }
    }
  }

  Box console_box {
    visible: false;
    vexpand: true;
    margin-start: 40;
    margin-end: 40;
    margin-top: 24;
    height-request: 320;
    orientation: vertical;

    ScrolledWindow {
      vexpand: true;
      hexpand: true;
      margin-top: 12;
      margin-start: 12;
      margin-end: 12;
      margin-bottom: 12;

      TextView log_view {
        editable: false;
        monospace: true;
        wrap-mode: word_char;
        top-margin: 8;
        bottom-margin: 8;
        left-margin: 8;
        right-margin: 8;

        styles ["log-view"]
      }
    }

    styles [
      "card",
    ]
  }

  // The install status, in a clamp so it keeps a readable width on a wide
  // window. With no media or log pane open it is centred in the page; with
  // one open it sits under the pane at its natural height
  // (views/progress.py __sync_status_layout).
  Adw.Clamp status_clamp {
    maximum-size: 600;
    tightening-threshold: 480;
    vexpand: true;
    valign: center;
    margin-start: 24;
    margin-end: 24;
    margin-top: 24;
    margin-bottom: 32;

    Box {
      orientation: vertical;
      spacing: 6;

      Label progressbar_text {
        wrap: true;
        wrap-mode: word_char;
        justify: center;
        label: _("Installing");

        styles [
          "title-1",
        ]
      }

      Label progress_substep {
        wrap: true;
        wrap-mode: word_char;
        justify: center;
        label: "";

        styles [
          "dim-label",
        ]
      }

      ProgressBar progressbar {
        show-text: false;
        margin-top: 18;

        styles [
          "thick-progress",
        ]
      }

      Box {
        orientation: horizontal;
        spacing: 12;
        margin-top: 2;

        Label progress_elapsed {
          xalign: 0;
          label: _("0:00 elapsed");

          styles [
            "dim-label",
            "caption",
            "numeric",
          ]
        }

        Label progress_eta {
          xalign: 0;
          hexpand: true;
          label: "";

          styles [
            "dim-label",
            "caption",
            "numeric",
          ]
        }

        Label progress_percentage {
          halign: end;
          label: "0%";

          styles [
            "heading",
            "numeric",
          ]
        }
      }

      // progress_note from the branding contract, set by views/progress.py.
      Label progress_note {
        wrap: true;
        wrap-mode: word_char;
        justify: center;
        margin-top: 12;
        label: "";

        styles [
          "dim-label",
          "caption",
        ]
      }

      Box {
        orientation: horizontal;
        halign: center;
        spacing: 12;
        margin-top: 12;

        Button copy_log_button {
          visible: true;
          icon-name: "edit-copy-symbolic";
          tooltip-text: _("Copy Console Log");

          styles [
            "circular",
          ]
        }

        Button console_button {
          visible: true;
          icon-name: "media-view-subtitles-symbolic";
          tooltip-text: _("Show Console Output");

          styles [
            "circular",
          ]
        }

        Button media_button {
          visible: false;
          icon-name: "media-playback-start-symbolic";
          tooltip-text: _("Show Installation Media");

          styles [
            "circular",
          ]
        }
      }
    }
  }
}
