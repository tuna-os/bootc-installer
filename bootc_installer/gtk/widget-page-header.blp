using Gtk 4.0;

template $BootcPageHeader: Gtk.Box {
  orientation: vertical;
  spacing: 18;
  halign: center;

  // Hidden until a page sets an icon (widgets/page_header.py).
  Image _icon {
    visible: false;
    pixel-size: 128;
  }

  Box {
    orientation: vertical;
    spacing: 6;

    Label _title_label {
      justify: center;
      max-width-chars: 65;
      wrap: true;

      styles [
        "title-1",
      ]
    }

    Label _subtitle_label {
      justify: center;
      max-width-chars: 65;
      wrap: true;
    }
  }
}
