using Gtk 4.0;
using Adw 1;

template $BootcConfirm: Adw.Bin {
  halign: fill;
  valign: fill;
  hexpand: true;

  ScrolledWindow {
    hscrollbar-policy: never;
    vexpand: true;
    hexpand: true;

    Adw.PreferencesPage {
      hexpand: true;

      Adw.PreferencesGroup {
        $BootcPageHeader page_header {
          margin-top: 24;
          title: _("Confirm installation");
          subtitle: "";
        }
      }

      // The erase warning: confirm_warning from the branding contract with
      // the chosen disk filled in, set by views/confirm.py. Hidden when the
      // install erases no whole disk.
      Adw.PreferencesGroup group_warning {
        visible: false;

        Adw.ActionRow row_warning {
          use-markup: false;
          title-lines: 0;

          [prefix]
          Image {
            icon-name: "dialog-warning-symbolic";
          }

          styles [
            "error",
          ]
        }
      }

      Adw.PreferencesGroup group_changes {
        title: _("Summary");
      }

      Adw.PreferencesGroup {
        Box {
          orientation: vertical;
          halign: center;
          spacing: 8;

          Label lbl_body {
            label: "";
            visible: false;
            halign: center;

            styles [
              "dim-label",
            ]
          }

          Button btn_confirm {
            label: _("Install");
            valign: center;
            halign: center;

            styles [
              "suggested-action",
              "pill",
            ]
          }
        }
      }
    }
  }
}
