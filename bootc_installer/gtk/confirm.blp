using Gtk 4.0;
using Adw 1;

template $BootcConfirm: Adw.Bin {
  halign: fill;
  valign: fill;
  hexpand: true;

  ScrolledWindow {
    hscrollbar-policy: never;
    vexpand: true;
    hexpand: true;

    Adw.PreferencesPage {
      hexpand: true;

      Adw.PreferencesGroup {
        $BootcPageHeader page_header {
          margin-top: 24;
          title: _("Confirm installation");
          subtitle: "";
        }
      }

      // The erase warning: confirm_warning from the branding contract with
      // the chosen disk filled in, set by views/confirm.py. Hidden when the
      // install erases no whole disk.
      Adw.PreferencesGroup group_warning {
        visible: false;

        Adw.ActionRow row_warning {
          use-markup: false;
          title-lines: 0;

          [prefix]
          Image {
            icon-name: "dialog-warning-symbolic";
          }

          styles [
            "error",
          ]
        }
      }

      Adw.PreferencesGroup group_changes {
        title: _("Summary");
      }

      // The install plan (tuna-os/fisherman#371): the disk that fisherman
      // will write to, what it reports about itself, and each device whose
      // data the install destroys, from `fisherman plan --json -`. Filled
      // by views/confirm.py; hidden when fisherman gives no plan.
      Adw.PreferencesGroup group_plan {
        visible: false;
      }

      // The install source (#267): download the image (the default), or
      // copy the system that this computer runs from its bootc storage.
      // views/confirm.py shows it only when fisherman's probe has an item
      // that qualifies; never on live media.
      Adw.PreferencesGroup group_reuse {
        visible: false;
      }

      Adw.PreferencesGroup {
        Box {
          orientation: vertical;
          halign: center;
          spacing: 8;

          Label lbl_body {
            label: "";
            visible: false;
            halign: center;

            styles [
              "dim-label",
            ]
          }

          Button btn_confirm {
            label: _("Install");
            valign: center;
            halign: center;

            // Destructive: Install erases the disk named in the warning above,
            // like the red Install button in the other frontends.
            styles [
              "destructive-action",
              "pill",
            ]
          }
        }
      }

      // The source check (#266) and this computer's bootc storage (#267),
      // filled by views/confirm.py from fisherman's probe. Under Install,
      // so that it does not push the button off the window; a blocked
      // source makes the button insensitive.
      Adw.PreferencesGroup group_source {
        title: _("Selected image");
        visible: false;
      }
    }
  }
}
