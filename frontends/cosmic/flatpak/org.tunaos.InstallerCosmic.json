{
  "app-id": "org.tunaos.InstallerCosmic",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "tuna-installer-cosmic",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=all",
    "--filesystem=host",
    "--talk-name=org.freedesktop.Flatpak",
    "--system-talk-name=org.freedesktop.PolicyKit1"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/tuna-installer-cosmic/cargo",
      "TUNA_SHARED_DIR": "/run/build/tuna-installer-cosmic/shared",
      "GOPATH": "/run/build/go-path",
      "GOCACHE": "/run/build/go-cache",
      "GOPROXY": "off"
    }
  },
  "modules": [
    "../../../shared/flatpak/go.json",
    "../../../shared/flatpak/fisherman.json",
    {
      "name": "tuna-installer-cosmic",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline build --release",
        "install -Dm755 target/release/tuna-installer-cosmic /app/bin/tuna-installer-cosmic",
        "install -Dm644 data/org.tunaos.InstallerCosmic.desktop /app/share/applications/org.tunaos.InstallerCosmic.desktop",
        "install -Dm644 data/org.tunaos.InstallerCosmic.metainfo.xml /app/share/metainfo/org.tunaos.InstallerCosmic.metainfo.xml",
        "install -Dm644 data/icons/hicolor/scalable/apps/org.tunaos.InstallerCosmic.svg /app/share/icons/hicolor/scalable/apps/org.tunaos.InstallerCosmic.svg"
      ],
      "sources": [
        { "type": "dir", "path": ".." },
        { "type": "dir", "path": "../../../shared", "dest": "shared" },
        "cargo-sources.json"
      ]
    }
  ]
}
