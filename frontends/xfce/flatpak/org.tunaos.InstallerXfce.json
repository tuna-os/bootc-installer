{
  "app-id": "org.tunaos.InstallerXfce",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "command": "tuna-installer-xfce",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=all",
    "--filesystem=host",
    "--talk-name=org.freedesktop.Flatpak",
    "--system-talk-name=org.freedesktop.PolicyKit1"
  ],
  "build-options": {
    "env": {
      "GOPATH": "/run/build/go-path",
      "GOCACHE": "/run/build/go-cache",
      "GOPROXY": "off"
    }
  },
  "separate-locales": false,
  "modules": [
    "../../../shared/flatpak/go.json",
    "../../../shared/flatpak/fisherman.json",
    {
      "name": "tuna-installer-xfce",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/lib/tuna-installer-xfce",
        "cp -r tuna_installer_xfce /app/lib/tuna-installer-xfce/",
        "cp -r shared/python/bootc_shared /app/lib/tuna-installer-xfce/",
        "install -Dm644 shared/account/groups.json /app/lib/tuna-installer-xfce/bootc_shared/data/account/groups.json",
        "install -Dm644 shared/branding/copy-defaults.json /app/lib/tuna-installer-xfce/bootc_shared/data/branding/copy-defaults.json",
        "install -Dm644 shared/progress/dry-run-transcript.ndjson /app/lib/tuna-installer-xfce/bootc_shared/data/progress/dry-run-transcript.ndjson",
        "install -Dm644 shared/recipe/encryption-choices.json /app/lib/tuna-installer-xfce/bootc_shared/data/recipe/encryption-choices.json",
        "for po in po/*.po; do lang=$(basename \"$po\" .po); install -d /app/share/locale/$lang/LC_MESSAGES; msgfmt --check -o /app/share/locale/$lang/LC_MESSAGES/tuna-installer-xfce.mo \"$po\"; done",
        "install -Dm755 tuna-installer-xfce /app/bin/tuna-installer-xfce",
        "install -Dm644 data/org.tunaos.InstallerXfce.desktop /app/share/applications/org.tunaos.InstallerXfce.desktop",
        "install -Dm644 data/org.tunaos.InstallerXfce.metainfo.xml /app/share/metainfo/org.tunaos.InstallerXfce.metainfo.xml",
        "install -Dm644 data/icons/hicolor/scalable/apps/org.tunaos.InstallerXfce.svg /app/share/icons/hicolor/scalable/apps/org.tunaos.InstallerXfce.svg"
      ],
      "sources": [
        { "type": "dir", "path": ".." },
        { "type": "dir", "path": "../../../shared/python/bootc_shared", "dest": "shared/python/bootc_shared" },
        { "type": "file", "path": "../../../shared/account/groups.json", "dest": "shared/account" },
        { "type": "file", "path": "../../../shared/branding/copy-defaults.json", "dest": "shared/branding" },
        { "type": "file", "path": "../../../shared/progress/dry-run-transcript.ndjson", "dest": "shared/progress" },
        { "type": "file", "path": "../../../shared/recipe/encryption-choices.json", "dest": "shared/recipe" }
      ]
    }
  ]
}
