{
  "app-id": "org.tunaos.InstallerKde",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.11",
  "sdk": "org.kde.Sdk",
  "command": "tuna-installer-kde",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=all",
    "--filesystem=host",
    "--talk-name=org.freedesktop.Flatpak",
    "--system-talk-name=org.freedesktop.PolicyKit1"
  ],
  "build-options": {
    "env": {
      "GOPATH": "/run/build/go-path",
      "GOCACHE": "/run/build/go-cache",
      "GOPROXY": "off"
    }
  },
  "modules": [
    "../../../shared/flatpak/go.json",
    "../../../shared/flatpak/fisherman.json",
    {
      "name": "kirigami-addons",
      "buildsystem": "cmake-ninja",
      "config-opts": ["-DBUILD_TESTING=OFF", "-DCMAKE_BUILD_TYPE=Release"],
      "sources": [
        {
          "type": "git",
          "url": "https://invent.kde.org/libraries/kirigami-addons.git",
          "tag": "v1.7.0"
        }
      ]
    },
    {
      "name": "tuna-installer-kde",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DTUNA_SHARED_DIR=/run/build/tuna-installer-kde/shared"
      ],
      "sources": [
        { "type": "dir", "path": ".." },
        { "type": "dir", "path": "../../../shared", "dest": "shared" }
      ]
    }
  ]
}
