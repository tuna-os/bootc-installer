// Niri installer — Quickshell + Go installer wizard
//
// QML (Quickshell) UI layer over the Go backend in ../installer, which wraps
// fisherman. Backend binary is resolved from $TUNA_BACKEND or PATH
// ("tuna-installer-backend"; the Flatpak installs it at /app/bin).
//
// Visual design: DankMaterialShell (../DESIGN.md). Every surface, control and
// type size comes from Theme.qml, which mirrors DMS's Style.qml tokens, and
// the controls are the DMS widget set (DankButton, DankCard, DankListItem,
// DankTextField, StyledText) rebuilt on plain Qt Quick so the installer draws
// the same inside the DMS session and under the docs capture harness.

import QtQuick
import QtQuick.Controls
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import "."
import "progress.js" as BarMath

ApplicationWindow {
    id: root
    title: root.productName + " Installer"
    width: 800
    height: 600
    visible: true
    color: Theme.surface
    font.family: Theme.fontFamily
    font.pixelSize: Theme.fontSizeMedium

    // Qt Quick Controls that are not one of the Dank widgets (the log
    // ScrollView) still pick up the DMS palette.
    palette.window: Theme.surface
    palette.windowText: Theme.surfaceText
    palette.base: Theme.surfaceContainerLow
    palette.alternateBase: Theme.surfaceContainer
    palette.text: Theme.surfaceText
    palette.button: Theme.surfaceContainerHigh
    palette.buttonText: Theme.surfaceText
    palette.highlight: Theme.primary
    palette.highlightedText: Theme.primaryText
    palette.placeholderText: Theme.outline
    palette.mid: Theme.surfaceVariant
    palette.dark: Theme.surfaceContainerLowest

    property string backendBin: Quickshell.env("TUNA_BACKEND") || "tuna-installer-backend"

    // Product identity from the backend's `detect` (shared/branding/README.md:
    // branding.json first, os-release second, neutral last). The QML never
    // names a product; before detect answers it shows the neutral name.
    property var branding: ({})
    readonly property string productName: branding.name || "Linux"
    readonly property string productLogo: branding.logoKind === "file"
        ? (branding.logoValue || "")
        : (branding.logoKind === "theme" ? Quickshell.iconPath(branding.logoValue, true) : "")
    readonly property string storeUrl: branding.storeUrl || ""

    // Flavour text (shared/branding copy keys) with {name}/{disk} filled in.
    // Neutral until detect delivers the branding; never a product literal.
    // The table below is shared/branding/copy-defaults.json written out as a
    // JS object. QML cannot read the file and the backend that would send
    // branding.copy is stubbed in every capture run, so this is what the
    // walkthrough actually renders. Being a copy, it drifts -- it was missing
    // welcome_install_subtitle from the day that key was added.
    //
    // So it is generated by shared/branding/generate-qml-defaults.py and
    // never hand-edited; tests/unit/test_copy_coverage.py parses it back out
    // of this file and requires it to match the canonical file key for key
    // and value for value.
    function text(key, values) {
        const copy = root.branding.copy || {}
        // COPY-DEFAULTS-BEGIN (generated by shared/branding/generate-qml-defaults.py)
        const defaults = ({
            welcome_title: "Welcome to {name}",
            welcome_subtitle: "",
            welcome_install: "Install {name}",
            welcome_install_subtitle: "Installs to your internal disk.",
            welcome_button: "Get started",
            requirements_title: "This computer does not meet the minimum requirements",
            requirements_ram: "It has less than 4 GB of memory.",
            requirements_cpu: "It has fewer than 2 processor cores.",
            requirements_uefi: "It did not start in UEFI mode. Turn on UEFI in the firmware settings.",
            encryption_none_label: "No encryption",
            encryption_none_description: "Anyone with the disk can read your files.",
            encryption_luks_passphrase_label: "Passphrase",
            encryption_luks_passphrase_description: "You'll type it at every boot.",
            encryption_tpm2_luks_label: "TPM",
            encryption_tpm2_luks_description: "Unlocks automatically on this hardware.",
            encryption_tpm2_luks_passphrase_label: "TPM + passphrase",
            encryption_tpm2_luks_passphrase_description: "Automatic unlock, passphrase as fallback.",
            confirm_title: "Confirm installation",
            confirm_subtitle: "",
            confirm_body: "",
            confirm_warning: "Everything on {disk} will be erased. This cannot be undone.",
            confirm_warning_removable: "{disk} is a removable drive. Make sure it isn't your install media or another disk you want to keep. Everything on it will be erased, and this cannot be undone.",
            confirm_button: "Install",
            progress_title: "Installing {name}…",
            progress_note: "Do not power off the computer.",
            step_prepare_disk: "Checking your drive…",
            step_partition: "Setting up your drive…",
            step_format_efi: "Preparing the boot system…",
            step_luks: "Securing your drive…",
            step_format_root: "Formatting your drive…",
            step_mount: "Almost ready…",
            step_format_var: "Preparing data storage…",
            step_install_os: "Installing {name}…",
            step_tpm2_enroll: "Setting up auto-unlock…",
            step_flatpaks: "Installing your apps…",
            step_configure: "Configuring your system…",
            step_finalize: "Finishing up…",
            recovery_key_title: "Save your recovery key",
            recovery_key_body: "If your disk fails to unlock automatically, you will need this recovery key to access your data. Save it somewhere safe, like a password manager or a printed copy.",
            recovery_key_copy: "Copy to clipboard",
            recovery_key_ack: "I have saved my recovery key",
            done_title: "{name} is installed",
            done_subtitle: "Remove the installation media and restart the computer.",
            done_restart: "Restart now",
            done_failed_title: "Installation failed",
            done_cancelled_title: "Installation cancelled",
            store_label: "Visit the store",
            validate_hostname_required: "Enter a name for this computer.",
            validate_hostname_too_long: "Use 64 characters or fewer for the computer name.",
            validate_hostname_invalid_char: "Use only letters, digits, hyphens and dots in the computer name.",
            validate_hostname_label_empty: "The computer name cannot start or end with a dot, or have two dots together.",
            validate_hostname_label_too_long: "Each part of the computer name between dots must be 63 characters or fewer.",
            validate_hostname_label_hyphen: "A part of the computer name cannot start or end with a hyphen.",
            validate_username_too_long: "Use 32 characters or fewer for the username.",
            validate_username_invalid_start: "Start the username with a lowercase letter or an underscore.",
            validate_username_invalid_char: "Use only lowercase letters, digits, underscores and hyphens in the username.",
            validate_username_reserved: "This username is used by the system. Choose a different one.",
            validate_slurp_unsupported: "Data migration is not available yet. Turn it off to install.",
            validate_distro_id_invalid: "Use only lowercase letters, digits and hyphens in the distro ID.",
            validate_brew_tap_invalid: "Write the Homebrew tap as owner/name, with no spaces or symbols.",
            validate_encryption_unsupported: "This encryption type is not supported.",
            validate_encryption_passphrase_required: "Enter a passphrase.",
            validate_encryption_unsupported_on_zfs: "ZFS cannot be encrypted. Choose a different filesystem or no encryption.",
            validate_encryption_unsupported_on_manual_layout: "Encryption is not available with manual partitioning.",
            validate_encryption_tpm_unavailable: "This computer has no usable TPM. Choose a different encryption type.",
            validate_filesystem_unsupported: "This filesystem is not supported.",
            validate_btrfs_subvolumes_require_btrfs: "Subvolumes need the Btrfs filesystem.",
            validate_composefs_requires_fsverity: "This system image needs ext4 or Btrfs, not XFS.",
            validate_disk_required: "Choose a disk to install to.",
            validate_disk_not_found: "The selected disk is no longer connected.",
            validate_custom_mount_partition_required: "Choose a partition for each mount point.",
            validate_custom_mount_partition_not_found: "A selected partition is no longer present.",
            validate_custom_mount_fstype_unsupported: "A selected partition format is not supported.",
            validate_custom_mounts_no_root: "Choose a partition for the root folder (/).",
            validate_var_disk_required: "Choose a data disk.",
            validate_var_disk_not_found: "The selected data disk is no longer connected.",
            validate_var_disk_same_as_disk: "Choose a data disk that is not the system disk.",
            validate_image_required: "Choose a system image to install.",
            validate_image_type_unsupported: "This type of system image is not supported.",
            validate_bootloader_unsupported: "This boot loader is not supported.",
            validate_recipe_unreadable: "The installer could not read its settings.",
            validate_recipe_malformed: "The installer settings are not valid."
        })
        // COPY-DEFAULTS-END
        let line = copy[key] !== undefined ? copy[key] : (defaults[key] || "")
        line = line.split("{name}").join(root.productName)
        for (const k in (values || {}))
            line = line.split("{" + k + "}").join(values[k])
        return line
    }

    // Wizard state
    // 0=welcome, 1=session, 2=source, 3=disk, 4=encryption, 5=account,
    // 6=confirm, 7=progress, 8=done. The account page is skipped when the
    // selected image makes its own first user (needs_user_creation), via
    // flowPages below — currentPage still names the StackLayout child.
    property int currentPage: 0
    readonly property var pageNames: ["Welcome", "Session", "Source", "Disk", "Encryption", "Account", "Confirm", "Installing", "Done"]

    // The pages the user actually steps through. The account page drops
    // out when the catalog leaf says the image creates its own user
    // (XFCE's needs_user_creation, bootc_installer/defaults/image.py),
    // instead of asking for an account fisherman would then ignore.
    readonly property var flowPages: root.needsUserCreation ? [0, 1, 2, 3, 4, 5, 6, 7, 8] : [0, 1, 2, 3, 4, 6, 7, 8]
    readonly property int flowPos: Math.max(0, root.flowPages.indexOf(root.currentPage))
    readonly property int flowCount: root.flowPages.length
    function flowNext() {
        const next = Math.min(root.flowPos + 1, root.flowCount - 1)
        root.currentPage = root.flowPages[next]
    }
    function flowBack() {
        const prev = Math.max(root.flowPos - 1, 0)
        root.currentPage = root.flowPages[prev]
    }

    // Slugs for the readiness stamp. Kept in the same order as currentPage
    // above, and matching the names the other frontends use so the tunaOS
    // screen contract reads one vocabulary rather than five.
    function pageSlug(i) {
        const slugs = ["welcome", "session", "source", "disk", "encryption", "account", "confirm", "installing", "done"]
        return (i >= 0 && i < slugs.length) ? slugs[i] : "unknown"
    }
    // Encryption was previously hardcoded to "none" in the recipe with no UI,
    // so every install came out unencrypted (tuna-os/tunaOS#734).
    property string encType: "none"
    // The encryption choices in display order, with needs_passphrase and
    // needs_tpm2: fisherman's data/encryption-choices.json, which the backend
    // embeds and `detect` reports (tests/unit/test_encryption_choices.py).
    property var encryptionChoices: []
    readonly property var encryptionTypes: encryptionChoices.map(c => c.type)
    function encryptionChoice(type) {
        return encryptionChoices.find(c => c.type === (type || "none")) || ({})
    }
    function needsPassphrase(type) { return encryptionChoice(type).needs_passphrase === true }
    function needsTpm2(type) { return encryptionChoice(type).needs_tpm2 === true }
    readonly property var offeredEncryptionTypes: encryptionChoices
        .filter(c => root.hasTpm || c.needs_tpm2 !== true).map(c => c.type)
    // What a type is called: suffix "_label" or "_description", branding
    // copy (shared/branding/README.md, "Encryption choices"). "" is none.
    function encryptionText(type, suffix) {
        return root.text("encryption_" + (type || "none").split("-").join("_") + suffix)
    }
    property string passphrase: ""
    property bool hasTpm: false
    // fisherman's system.unmet from `detect` ("ram", "cpu", "uefi").
    property var unmet: []
    // The disks fisherman offers, from `discover-disks`; why there are none
    // when the probe failed (no fallback scan, shared/probe/README.md).
    property var disks: []
    property bool disksProbed: false
    property string diskError: ""
    // The welcome page's warning: requirements_title, then a line per item.
    readonly property string requirementsWarning: {
        const keys = { ram: "requirements_ram", cpu: "requirements_cpu", uefi: "requirements_uefi" }
        const known = root.unmet.filter(u => keys[u] !== undefined)
        if (known.length === 0) return ""
        return [root.text("requirements_title")].concat(known.map(u => root.text(keys[u])))
            .filter(l => l !== "").join("\n")
    }
    property var selectedDisk: ({})
    property bool hostnameTouched: false
    property string hostname: branding.defaultHostname || "linux"
    // The account fisherman creates: the recipe's `user` block. Required:
    // this frontend has no image catalog to say an image makes its own first
    // user (needs_user_creation), so, as on XFCE without a catalog entry, the
    // wizard always creates one. Held in memory and sent only on the
    // install's stdin, with the rest of the recipe.
    property string username: ""
    property string fullname: ""
    property string userPassword: ""
    property string userPasswordConfirm: ""
    readonly property bool passwordsMatch: userPassword === userPasswordConfirm
    // Continue on the account page: a username and a password, typed the
    // same twice, and no fisherman problem with the username.
    readonly property bool accountReady: username !== "" && userPassword !== ""
        && passwordsMatch && usernameProblem === ""
    property bool installSuccess: false
    // The key fisherman emits once, after TPM enrolment (#129). The
    // "recovery_key" case in renderEvent used to format a log line and keep
    // nothing, so after the install there was nothing left to show.
    property string recoveryKey: ""
    property bool recoveryAck: false
    // Restart is held while an unacknowledged key is on screen: leaving the
    // done page is what ends the chance to read it. A failed install enrolled
    // nothing, and a non-TPM install was never given a key, so neither is held.
    readonly property bool recoveryKeyPending:
        installSuccess && recoveryKey !== "" && !recoveryAck
    property string installLog: ""
    // The determinate bar is driven by fisherman's newline-delimited JSON
    // progress protocol (shared/progress/README.md).
    //
    // This used to be `/^\[(\d+)\/(\d+)\]/` against a fixed nine steps.
    // fisherman has never emitted that prefix — it writes JSON on stdout and
    // nothing else — so the bar stayed at zero and the caption read
    // "Starting…" for the whole of every install. The step count was wrong
    // independently: fisherman computes total_steps from the recipe (8,
    // adjusted for manual layout, LUKS, TPM2 enrolment and a separate /var
    // disk), so nine was never right either.
    //
    // installFraction, not step/total: "Installing OS" alone is 87% of a cold
    // install and five other steps are 0%, so a bar advanced one-nth per step
    // sits near empty for the whole visible install and then jumps.
    property int installStep: 0
    property int installSteps: 0
    property real installFraction: 0
    property string installStepName: ""
    // Parser context carried across lines, for substep interpolation.
    // Parser state for the bar (ui/progress.js), carried across lines.
    property var barState: BarMath.newState()
    // Recipe JSON awaiting the backend child's stdin channel (fed on
    // Process.started). Kept on the root so the passphrase-bearing recipe
    // never appears in the install command argv (see #22).
    property string pendingRecipe: ""

    // Live media from `detect`: fisherman's probe (`live`). Only on live
    // media may the recipe leave `image` empty, which installs the running
    // system; liveImage names it for the summary. The offline stores are
    // fisherman's to find: the recipe leaves additionalImageStores out.
    property bool isLive: false
    property string liveImage: ""
    // fisherman's offline.images: what needs no download. Joined against
    // the catalog here (sortedLeaves, isOffline), never sent anywhere.
    property var offlineImages: []

    // fisherman's answer to `validate --json --partial` for the fields the
    // wizard has (hostname, encryption): {field: problem}. The rules are
    // fisherman's (shared/recipe/README.md); a check that cannot run leaves
    // this empty and blocks nothing.
    property var problems: ({})
    function problemText(field) {
        const p = problems[field]
        if (!p) return ""
        // The copy key validate_<code>, else fisherman's own message.
        return (p.code ? root.text("validate_" + p.code) : "") || p.message || ""
    }
    readonly property string hostnameProblem: problemText("hostname")
    // user.username: shown through the copy keys validate_username_*.
    readonly property string usernameProblem: problemText("user.username")
    readonly property string encryptionProblem:
        problemText("encryption.passphrase") || problemText("encryption.type")
    // fisherman's filesystem rule (LUKS on ZFS, composefs needing
    // ext4-or-btrfs): the Advanced section's choice, checked live.
    readonly property string filesystemProblem: problemText("filesystem")
    property string pendingValidate: ""
    property bool validateAgain: false
    function partialRecipe() {
        const enc = { type: root.encType }
        if (root.needsPassphrase(root.encType)) enc.passphrase = root.passphrase
        // XFCE's build_recipe rules: btrfsSubvolumes only means anything
        // on btrfs, and the user block is omitted when the image makes
        // its own first user (the schema's "empty skips" would drop a
        // block with no username anyway).
        const recipe = { hostname: root.hostname, filesystem: root.filesystem,
            btrfsSubvolumes: root.filesystem === "btrfs" && root.btrfsSubvolumes,
            encryption: enc, image: root.selectedImage }
        if (root.needsUserCreation)
            recipe.user = { username: root.username }
        return recipe
    }
    function checkFields() { validateTimer.restart() }
    onHostnameChanged: checkFields()
    onPassphraseChanged: checkFields()
    onEncTypeChanged: checkFields()
    onUsernameChanged: checkFields()
    onFilesystemChanged: checkFields()
    onBtrfsSubvolumesChanged: checkFields()
    onSelectedImageChanged: checkFields()
    // The image installed off a live ISO: branding.json's default_image.
    // Empty means the backend refuses ("image is required") rather than
    // installing somebody else's product.
    readonly property string defaultImage: branding.defaultImage || ""

    // Filesystem (XFCE SetupPage parity). The default follows the selected
    // catalog leaf until the user picks one in Advanced; the recipe and the
    // confirm summary read this, never a literal.
    readonly property var filesystems: ["xfs", "ext4", "btrfs", "zfs"]
    property string filesystem: "xfs"
    property bool fsChosen: false
    property bool btrfsSubvolumes: false
    function showFilesystem(fs) {
        if (root.filesystems.indexOf(fs) === -1 && fs !== "")
            return
        root.filesystem = fs || "xfs"
    }

    // Image catalog (`catalog` subcommand, XFCE SourcePage parity). The
    // offline mark is the probe's offline.images joined here, so the
    // backend stays runnable with no probe and no network.
    property var catalogLeaves: []
    property string catalogDefaultImage: ""
    property bool catalogLoaded: false
    property string catalogError: ""
    property var selectedLeaf: null
    property bool selectedLive: false
    readonly property var sortedLeaves: {
        const off = root.offlineImages || []
        return (root.catalogLeaves || []).slice().sort((a, b) =>
            ((off.indexOf(b.imgref) !== -1) - (off.indexOf(a.imgref) !== -1))
            || String(a.name).localeCompare(String(b.name)))
    }
    function isOffline(imgref) { return (root.offlineImages || []).indexOf(imgref) !== -1 }
    // Whether the wizard asks for an account: the leaf's
    // needs_user_creation (XFCE's win.needs_user_creation), defaulting to
    // true the way the manifest does — an unknown image still gets a user.
    readonly property bool needsUserCreation:
        !root.selectedLeaf || root.selectedLeaf.needs_user_creation !== false
    readonly property string selectedImage: {
        if (root.isLive && root.selectedLive) return ""
        if (root.selectedLeaf && root.selectedLeaf.imgref) return root.selectedLeaf.imgref
        return root.catalogDefaultImage || root.defaultImage
    }
    readonly property bool sourceReady: (root.isLive && root.selectedLive) || root.selectedImage !== ""

    // Live-session preflight (`session-get` / `session-set`, GNOME
    // defaults/* parity for the live session only — the recipe has no
    // locale keys, and PARITY.md keeps them GNOME-only by design).
    property var keyboardLayouts: []
    property string keyboardLayout: ""
    property var localeList: []
    property string localeName: ""
    property var timezoneList: []
    property string timezoneName: ""
    property bool netConnected: false
    property bool sessionLoaded: false
    property string sessionError: ""
    readonly property var keyboardModel: root.keyboardLayouts.length > 0 ? root.keyboardLayouts : ["us", "de", "fr", "es", "uk"]
    readonly property var localeModel: root.localeList.length > 0 ? root.localeList : ["en_US.UTF-8", "de_DE.UTF-8", "fr_FR.UTF-8", "es_ES.UTF-8"]
    readonly property var timezoneModel: root.timezoneList.length > 0 ? root.timezoneList : ["UTC", "Europe/Berlin", "Europe/Paris", "America/New_York"]
    property string pendingSession: ""

    // Requirements gates (GNOME window_cpu/window_ram/window_unsupported
    // parity). The welcome page no longer warns inline: an unmet
    // requirement blocks there until the user accepts it (RAM/CPU) — UEFI
    // cannot be accepted, only powered off or rebooted into firmware.
    property bool gatesAccepted: false
    readonly property bool gateOpen: root.currentPage === 0 && root.unmet.length > 0 && !root.gatesAccepted
    readonly property bool gateUefi: root.unmet.indexOf("uefi") !== -1
    property bool powerOpen: false

    // Tour (views/tour.py parity): the selected leaf's carousel slides, if
    // any. Empty means no tour — the done page hides its button, and the
    // wizard never promises artwork nobody shipped.
    readonly property var tourSlides: (root.selectedLeaf && root.selectedLeaf.carousel) || []
    property bool tourOpen: false
    property int tourIndex: 0

    // The persistent install log (dialog_output.py parity): `detect`'s
    // logPath, named on the progress page next to its Copy button.
    property string logPath: ""

    Component.onCompleted: detectProc.running = true

    // Readiness stamp — see ../installer/readiness.go.
    //
    // tunaOS's installer-smoke.yml proves this frontend is up with
    // `flatpak ps`, which answers "is the process alive" rather than "did the
    // user get a window". Those already diverged: the COSMIC leg ran the
    // process with no window ever appearing and the check stayed green.
    //
    // frameSwapped, NOT Component.onCompleted. onCompleted fires when the
    // object tree finishes building, which happens whether or not anything
    // ever reaches the screen — stamping there would reproduce exactly the
    // gap this closes. frameSwapped means Qt swapped a frame to the
    // compositor, which is the strongest claim of the five frontends.
    //
    // Cancelling on exit (window_cpu/window_ram parity is the gate; this
    // is the other half of stopping): closing mid-install kills the
    // wrapper's process group via `cancel` instead of orphaning fisherman
    // while its SIGHUP forwarding is still only best-effort.
    onClosing: (close) => {
        if (root.currentPage === 7 && installProc.running)
            cancelProc.running = true
        close.accepted = true
    }

    // Fires on every frame, so `stamped` makes it a one-shot: this spawns a
    // process, and doing that at 60Hz would be its own bug.
    property bool stamped: false
    onFrameSwapped: {
        if (!root.stamped) {
            root.stamped = true
            readinessProc.running = true
        }
    }

    Process {
        id: readinessProc
        command: [root.backendBin, "readiness", root.pageSlug(root.currentPage)]
    }

    Process {
        id: detectProc
        command: [root.backendBin, "detect"]
        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    const facts = JSON.parse(text)
                    root.isLive = facts.isLive === true
                    root.liveImage = facts.liveImage || ""
                    root.hasTpm = facts.hasTpm === true
                    root.unmet = facts.unmet || []
                    if (facts.offlineImages) root.offlineImages = facts.offlineImages
                    if (facts.logPath !== undefined) root.logPath = facts.logPath
                    if (facts.encryptionChoices) root.encryptionChoices = facts.encryptionChoices
                    if (facts.branding) root.branding = facts.branding
                } catch (e) { /* detect is best-effort */ }
            }
        }
    }

    // After a pause in the typing, one `validate` at a time: the backend runs
    // `fisherman validate --json --partial -` with the page's fields on
    // stdin (never argv: the passphrase is one of them).
    Timer {
        id: validateTimer
        interval: 300
        onTriggered: {
            if (validateProc.running) { root.validateAgain = true; return }
            root.pendingValidate = JSON.stringify(root.partialRecipe())
            validateProc.running = true
        }
    }
    Process {
        id: validateProc
        command: [root.backendBin, "validate"]
        stdinEnabled: true
        onStarted: {
            validateProc.write(root.pendingValidate)
            root.pendingValidate = ""
        }
        stdout: StdioCollector {
            onStreamFinished: {
                let answer = null
                try { answer = JSON.parse(text) } catch (e) { answer = null }
                const found = {}
                if (answer && Array.isArray(answer.errors)) {
                    for (const p of answer.errors)
                        if (p && p.field && found[p.field] === undefined) found[p.field] = p
                }
                // No answer (exit 2, an old fisherman): nothing is known.
                root.problems = found
            }
        }
        onExited: (code, status) => {
            if (root.validateAgain) { root.validateAgain = false; validateTimer.restart() }
        }
    }

    Process {
        id: discoverProc
        command: [root.backendBin, "discover-disks"]
        stdout: StdioCollector {
            onStreamFinished: {
                try { root.disks = JSON.parse(text) || [] } catch (e) { root.disks = [] }
                root.disksProbed = true
                // Keep the choice across a re-probe only if the disk is still offered.
                if (root.selectedDisk.path !== undefined
                        && !root.disks.some(d => d.path === root.selectedDisk.path))
                    root.selectedDisk = ({})
            }
        }
        stderr: StdioCollector {
            onStreamFinished: root.diskError = text.trim()
        }
    }

    // Image catalog for the Source step (`catalog` subcommand): leaves
    // with inheritance resolved. Empty is not an error — the wizard falls
    // back to the branding default image, the live-ISO norm.
    Process {
        id: catalogProc
        command: [root.backendBin, "catalog"]
        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    const doc = JSON.parse(text)
                    const leaves = doc.leaves || []
                    root.catalogLeaves = leaves
                    root.catalogDefaultImage = doc.default_image || ""
                    // GTK's first radio is active from the start; the QML
                    // list selects nothing on its own. Preselect the same
                    // row XFCE would: live media first, else the first
                    // leaf in display order (offline first, then by name).
                    if (!root.selectedLive && root.selectedLeaf === null) {
                        if (root.isLive) {
                            root.selectedLive = true
                        } else if (leaves.length > 0) {
                            const off = root.offlineImages || []
                            const first = leaves.slice().sort((a, b) =>
                                ((off.indexOf(b.imgref) !== -1) - (off.indexOf(a.imgref) !== -1))
                                || String(a.name).localeCompare(String(b.name)))[0]
                            root.selectedLeaf = first
                        }
                    }
                } catch (e) {
                    root.catalogLeaves = []
                    root.catalogError = "Could not read the image catalog."
                }
                root.catalogLoaded = true
            }
        }
        stderr: StdioCollector {
            onStreamFinished: {
                // An empty stderr is the success path (both streams close
                // at exit): only a message means the catalog failed.
                if (text.trim() === "")
                    return
                root.catalogLeaves = []
                root.catalogError = text.trim()
                root.catalogLoaded = true
            }
        }
    }

    // Live-session preflight (`session-get`): keyboard, locale, timezone
    // and connectivity. Best-effort reads — what fails stays empty and the
    // page offers its fallbacks.
    Process {
        id: sessionProc
        command: [root.backendBin, "session-get"]
        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    const state = JSON.parse(text)
                    if (state.keyboard) {
                        if (state.keyboard.current) root.keyboardLayout = state.keyboard.current
                        root.keyboardLayouts = state.keyboard.available || []
                    }
                    if (state.locale) {
                        if (state.locale.current) root.localeName = state.locale.current
                        root.localeList = state.locale.available || []
                    }
                    if (state.timezone) {
                        if (state.timezone.current) root.timezoneName = state.timezone.current
                        root.timezoneList = state.timezone.available || []
                    }
                    root.netConnected = state.connected === true
                } catch (e) { /* best-effort: the fallbacks stand in */ }
                root.sessionLoaded = true
            }
        }
        stderr: StdioCollector {
            onStreamFinished: root.sessionLoaded = true
        }
    }

    // Applying the preflight (`session-set`): the Session step's choice as
    // JSON on stdin — the same never-argv rule as the recipe, though these
    // values are only session configuration. Advances on exit.
    Process {
        id: sessionSetProc
        command: [root.backendBin, "session-set"]
        stdinEnabled: true
        onStarted: {
            sessionSetProc.write(root.pendingSession)
            root.pendingSession = ""
        }
        stderr: StdioCollector {
            id: sessionSetErr
            onStreamFinished: root.sessionError = text.trim()
        }
        onExited: (code, status) => {
            if (code === 0) {
                root.sessionError = ""
                root.flowNext()
            }
        }
    }

    // Stopping a running install (`cancel`): the wrapper's process group,
    // recorded by the backend — quitting mid-install must not orphan it.
    Process {
        id: cancelProc
        command: [root.backendBin, "cancel"]
    }

    // Power actions on the host (dialog_poweroff parity): systemctl
    // through flatpak-spawn when sandboxed, never in this runtime.
    Process {
        id: poweroffProc
        command: [root.backendBin, "poweroff"]
    }
    Process {
        id: firmwareProc
        command: [root.backendBin, "firmware"]
    }

    Process {
        id: installProc
        // The recipe may hold a LUKS passphrase. Feed it over stdin
        // (Process.write) instead of argv: /proc/PID/cmdline is
        // world-readable, so an argv recipe leaks the passphrase to any
        // local user while the backend runs. Quickshell starts the child
        // asynchronously, so write on the started signal — writing before
        // the child's stdin channel is open would drop the recipe.
        stdinEnabled: true
        onStarted: {
            installProc.write(root.pendingRecipe)
            root.pendingRecipe = ""
        }
        stdout: SplitParser {
            onRead: data => root.appendLog(data)
        }
        stderr: SplitParser {
            onRead: data => root.appendLog(data)
        }
        onExited: (code, status) => {
            root.installSuccess = (code === 0)
            root.currentPage = 8
        }
    }

    // One fisherman event, or a plain stderr line. Returns the text to show;
    // the protocol is machine-readable and this pane is not, so events are
    // rendered rather than dumped as JSON.
    function renderEvent(event) {
        switch (event.type) {
        case "step":
            return "[" + event.step + "/" + event.total_steps + "] " + (event.step_name || "")
        case "substep":
        case "info":
            return event.message ? "  " + event.message : ""
        case "complete":
            return event.message || "Installation complete"
        case "error":
            return "ERROR: " + (event.message || "")
        case "recovery_key":
            // Niri has no recovery-key screen (docs/PARITY.md), so this is
            // the only place the user can read a key they cannot recover
            // later. Hiding it here would lose it outright.
            return "Recovery key: " + (event.key || "")
        }
        return ""
    }

    function appendLog(line) {
        let event = null
        if (line.charAt(0) === "{") {
            try { event = JSON.parse(line) } catch (e) { event = null }
        }
        if (event === null || typeof event !== "object") {
            installLog += line + "\n"
            return
        }

        const shown = renderEvent(event)
        if (shown !== "")
            installLog += shown + "\n"

        // The bar: fisherman's overall_pct, else the shared/progress
        // derivation, in ui/progress.js.
        installFraction = BarMath.advance(barState, event)

        if (event.type === "step") {
            installStep = event.step
            installSteps = event.total_steps
            // The copy key step_<step_id> (shared/branding/README.md,
            // "Install steps"), else fisherman's step_name.
            installStepName = BarMath.stepLabel(event, id => root.text("step_" + id))
        } else if (event.type === "recovery_key") {
            recoveryKey = event.key || ""
        }
    }

    // Restart from the done page: the backend runs `systemctl reboot` on the
    // host (through flatpak-spawn when sandboxed), the same path the other
    // frontends use.
    Process {
        id: rebootProc
        command: [root.backendBin, "reboot"]
    }

    function startInstall() {
        installLog = ""
        installStep = 0
        installSteps = 0
        installFraction = 0
        installStepName = ""
        barState = BarMath.newState()
        currentPage = 7
        const leaf = root.selectedLeaf || {}
        const recipe = {
            disk: selectedDisk.path,
            filesystem: root.filesystem,
            // XFCE's build_recipe: subvolumes only on btrfs, whatever the
            // checkbox says; flatpaks split on whitespace, and a
            // "@"-prefixed value is a catalog reference, not a list.
            btrfsSubvolumes: root.filesystem === "btrfs" && root.btrfsSubvolumes,
            encryption: root.needsPassphrase(root.encType)
                ? { type: root.encType, passphrase: root.passphrase }
                : { type: root.encType },
            // Empty image = install the running system, which fisherman
            // accepts only on live media (probe's live.is_live).
            image: root.selectedImage,
            hostname: hostname,
            distroID: root.branding.id || "linux",
            // true makes bootc boot the installed system with selinux=0.
            selinuxDisabled: false
            // No additionalImageStores: fisherman exposes the host's stores.
        }
        // The leaf's install properties: absent keys mean "let fisherman
        // decide", which is not the same as an empty value.
        if (leaf.bootloader)
            recipe.bootloader = leaf.bootloader
        if (leaf.composefs === true)
            recipe.composeFsBackend = true
        const flats = Array.isArray(leaf.flatpaks) ? leaf.flatpaks.join(" ") : (leaf.flatpaks || "")
        if (flats !== "" && flats.charAt(0) !== "@")
            recipe.flatpaks = flats.split(/\s+/).filter(s => s !== "")
        // The account, as XFCE writes it: omitted when the image makes
        // its own first user, or with no username (the schema's "empty
        // skips"). The account page never lets the latter through.
        if (root.needsUserCreation && root.username !== "")
            recipe.user = {
                username: root.username,
                fullname: root.fullname,
                password: root.userPassword,
                groups: ["wheel"]
            }
        installProc.command = [root.backendBin, "install"]
        root.pendingRecipe = JSON.stringify(recipe)
        installProc.running = true
        // The recipe is fed over stdin on Process.started — never argv, so
        // the LUKS passphrase does not leak via /proc/PID/cmdline. See
        // tuna-os/tuna-installer-niri#22.
    }

    // The Session step's choice, applied to the live session (`session-set`
    // on stdin, like the recipe) before moving on. Applied even when
    // unchanged: the tools are idempotent and the page cannot know what a
    // previous run left behind.
    function applySession() {
        root.pendingSession = JSON.stringify({
            keyboard: keyCombo.currentText || "",
            locale: localeCombo.currentText || "",
            timezone: tzCombo.currentText || ""
        })
        sessionSetProc.running = true
    }
    // Leaving the Source step resolves the install's defaults the way
    // XFCE's SetupPage.on_enter does: the leaf's filesystem until the user
    // picks one, and the leaf's hostname seed until they type one.
    function chooseAndNext() {
        if (!root.sourceReady)
            return
        if (!root.fsChosen)
            root.showFilesystem((root.selectedLeaf && root.selectedLeaf.filesystem) || "")
        if (!root.hostnameTouched && root.selectedLeaf && root.selectedLeaf.default_hostname)
            root.hostname = root.selectedLeaf.default_hostname
        root.checkFields()
        root.flowNext()
    }
    // ── Keyboard: Enter advances, Shift+Enter goes back (the hint bar says so) ──
    function advance() {
        switch (currentPage) {
        case 0:
            discoverProc.running = true
            catalogProc.running = true
            sessionProc.running = true
            flowNext()
            break
        case 1: applySession(); break
        case 2: chooseAndNext(); break
        case 3: if (selectedDisk.path !== undefined) flowNext(); break
        case 4: encryptionPage.next(); break
        case 5: if (root.accountReady) flowNext(); break
        case 6:
            if (selectedDisk.path !== undefined && root.hostnameProblem === ""
                    && (!root.needsUserCreation || root.accountReady)) startInstall()
            break
        }
    }
    function back() {
        if (currentPage >= 1 && currentPage <= 6) flowBack()
    }
    Shortcut {
        sequence: "Return"
        enabled: !passField.activeFocus && !passConfirm.activeFocus && !hostField.activeFocus
            && !userField.activeFocus && !fullnameField.activeFocus
            && !userPassField.activeFocus && !userPassConfirm.activeFocus
            && !keyCombo.activeFocus && !localeCombo.activeFocus && !tzCombo.activeFocus
        onActivated: root.advance()
    }
    Shortcut { sequence: "Shift+Return"; onActivated: root.back() }

    // ── Layout: DMS top bar, page area, hint bar ─────────────────────────────
    ColumnLayout {
        anchors.fill: parent
        anchors.margins: Theme.spacingXL
        spacing: Theme.spacingL

        // Top bar (DMS bar look): step counter left, step dots right.
        RowLayout {
            Layout.fillWidth: true
            spacing: Theme.spacingM
            StyledText {
                text: "Step " + (root.flowPos + 1) + " of " + root.flowCount + " · " + root.pageNames[root.currentPage]
                color: Theme.surfaceVariantText
                font.pixelSize: Theme.fontSizeSmall
                font.weight: Theme.fontWeightMedium
            }
            Item { Layout.fillWidth: true }
            Row {
                spacing: Theme.spacingS
                Repeater {
                    model: root.flowCount
                    Rectangle {
                        required property int index
                        width: index === root.flowPos ? 24 : 8
                        height: 8
                        radius: 4
                        color: index <= root.flowPos ? Theme.primary : Theme.surfaceContainerHighest
                        Behavior on width { NumberAnimation { duration: Theme.mediumDuration; easing.type: Theme.standardEasing } }
                        Behavior on color { ColorAnimation { duration: Theme.mediumDuration } }
                    }
                }
            }
        }

        StackLayout {
            Layout.fillWidth: true
            Layout.fillHeight: true
            currentIndex: root.currentPage

            // Page 0: Welcome
            Item {
                ColumnLayout {
                    anchors.centerIn: parent
                    width: Math.min(parent.width, 520)
                    spacing: Theme.spacingL

                    // The shared branding logo (host file or theme icon) in a
                    // primaryContainer disc; a glyph otherwise.
                    Rectangle {
                        Layout.alignment: Qt.AlignHCenter
                        width: 96; height: 96; radius: 48
                        color: Theme.primaryContainer
                        Image {
                            id: welcomeLogo
                            objectName: "welcomeBrandingLogo"
                            anchors.centerIn: parent
                            width: 56; height: 56
                            source: root.productLogo
                            visible: status === Image.Ready
                            fillMode: Image.PreserveAspectFit
                        }
                        StyledText {
                            anchors.centerIn: parent
                            text: "⬢"
                            font.pixelSize: 40
                            color: Theme.primaryContainerText
                            visible: welcomeLogo.status !== Image.Ready
                        }
                    }
                    StyledText {
                        // "Welcome to <product>", matching the other frontends'
                        // welcome screen: the screen-parity contract keys the
                        // welcome screen off product-free words.
                        text: root.text("welcome_title")
                        font.pixelSize: Theme.fontSizeXXLarge
                        font.weight: Theme.fontWeightMedium
                        horizontalAlignment: Text.AlignHCenter
                        Layout.fillWidth: true
                    }
                    StyledText {
                        text: root.text("welcome_subtitle")
                        visible: text !== ""
                        font.pixelSize: Theme.fontSizeLarge
                        horizontalAlignment: Text.AlignHCenter
                        Layout.fillWidth: true
                    }
                    StyledText {
                        text: root.isLive
                            ? "Install this system — no download required."
                            : "This wizard will guide you through installing " + root.productName + " onto your computer."
                        color: Theme.surfaceVariantText
                        horizontalAlignment: Text.AlignHCenter
                        Layout.fillWidth: true
                    }
                    // fisherman's minimum requirements block here (GNOME's
                    // window_cpu/window_ram/window_unsupported parity):
                    // the gate dialog below covers this page until each
                    // unmet requirement is accepted or the host powers
                    // off. No inline warning — a warning is not a gate.
                    DankButton {
                        text: root.text("welcome_button")
                        buttonHeight: Theme.buttonHeightM
                        Layout.alignment: Qt.AlignHCenter
                        Layout.topMargin: Theme.spacingS
                        onClicked: root.advance()
                    }
                }
            }

            // Page 1: Session — live-session preflight (GNOME defaults/*
            // parity, applied to the live session only: the fisherman
            // recipe has no locale keys). Values apply on Continue via
            // `session-set`; a check that cannot run leaves its fallback.
            ColumnLayout {
                spacing: Theme.spacingM

                StyledText {
                    text: "Session"
                    font.pixelSize: Theme.fontSizeXLarge
                    font.weight: Theme.fontWeightMedium
                }
                StyledText {
                    text: "Keyboard, language, time and network for this live session. Nothing here goes into the installed system."
                    color: Theme.surfaceVariantText
                    wrapMode: Text.Wrap
                    Layout.fillWidth: true
                }

                DankCard {
                    Layout.fillWidth: true
                    title: "Keyboard and language"
                    GridLayout {
                        width: parent.width
                        columns: 2
                        columnSpacing: Theme.spacingXL
                        rowSpacing: Theme.spacingS

                        StyledText { text: "Keyboard"; color: Theme.surfaceVariantText }
                        ComboBox {
                            id: keyCombo
                            objectName: "sessionKeyboard"
                            editable: true
                            model: root.keyboardModel
                            currentIndex: Math.max(0, root.keyboardModel.indexOf(root.keyboardLayout))
                            implicitWidth: 300
                        }

                        StyledText { text: "Language"; color: Theme.surfaceVariantText }
                        ComboBox {
                            id: localeCombo
                            objectName: "sessionLocale"
                            editable: true
                            model: root.localeModel
                            currentIndex: Math.max(0, root.localeModel.indexOf(root.localeName))
                            implicitWidth: 300
                        }

                        StyledText { text: "Timezone"; color: Theme.surfaceVariantText }
                        ComboBox {
                            id: tzCombo
                            objectName: "sessionTimezone"
                            editable: true
                            model: root.timezoneModel
                            currentIndex: Math.max(0, root.timezoneModel.indexOf(root.timezoneName))
                            implicitWidth: 300
                        }
                    }
                }

                DankCard {
                    Layout.fillWidth: true
                    title: "Network"
                    RowLayout {
                        width: parent.width
                        spacing: Theme.spacingM
                        StyledText {
                            text: root.sessionLoaded
                                ? (root.netConnected ? "Connected — downloads will work." : "Offline — only installed or cached images can be used.")
                                : "Checking…"
                            color: root.sessionLoaded && !root.netConnected ? Theme.warning : Theme.surfaceVariantText
                            Layout.fillWidth: true
                        }
                        DankButton {
                            text: "Recheck"
                            tonal: true
                            enabled: !sessionProc.running
                            onClicked: sessionProc.running = true
                        }
                    }
                }

                StyledText {
                    text: root.sessionError
                    color: Theme.error
                    visible: text !== ""
                    font.pixelSize: Theme.fontSizeSmall
                    wrapMode: Text.Wrap
                    Layout.fillWidth: true
                }

                Item { Layout.fillHeight: true }

                RowLayout {
                    Layout.fillWidth: true
                    DankButton { text: "Back"; tonal: true; onClicked: root.back() }
                    Item { Layout.fillWidth: true }
                    DankButton {
                        text: "Continue"
                        enabled: !sessionSetProc.running
                        onClicked: root.applySession()
                    }
                }
            }

            // Page 2: Source — what to install (XFCE SourcePage parity).
            // Live media offers the running system; the catalog offers one
            // row per leaf, offline images first. With no catalog and no
            // live media the branding default stands in, the way the old
            // wizard installed it without asking.
            ColumnLayout {
                spacing: Theme.spacingM

                StyledText {
                    text: "What do you want to install?"
                    font.pixelSize: Theme.fontSizeXLarge
                    font.weight: Theme.fontWeightMedium
                }

                ListView {
                    id: sourceList
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    clip: true
                    spacing: Theme.groupedListGap
                    model: {
                        const rows = []
                        if (root.isLive)
                            rows.push({ live: true })
                        for (const leaf of root.sortedLeaves)
                            rows.push({ live: false, leaf: leaf })
                        if (rows.length === 0 && root.catalogLoaded)
                            rows.push({ fallback: true })
                        return rows
                    }
                    delegate: DankListItem {
                        required property var modelData
                        required property int index
                        width: sourceList.width
                        firstInGroup: index === 0
                        lastInGroup: index === sourceList.count - 1
                        primaryText: modelData.live
                            ? root.text("welcome_install")
                            : (modelData.fallback
                                ? (root.catalogDefaultImage || root.defaultImage || "Default image")
                                : modelData.leaf.name)
                        secondaryText: modelData.live
                            ? root.text("welcome_install_subtitle")
                            : (modelData.fallback
                                ? "No catalog found"
                                : [modelData.leaf.imgref,
                                   root.isOffline(modelData.leaf.imgref) ? "available offline" : "requires a download"]
                                    .filter(s => s).join("  ·  "))
                        isSelected: modelData.live ? root.selectedLive
                            : (modelData.fallback ? (root.selectedLeaf === null && !root.selectedLive)
                                : (root.selectedLeaf !== null && !root.selectedLive
                                    && root.selectedLeaf.imgref === modelData.leaf.imgref))
                        onClicked: {
                            if (modelData.live) {
                                root.selectedLive = true
                                root.selectedLeaf = null
                            } else if (modelData.fallback) {
                                root.selectedLive = false
                                root.selectedLeaf = null
                            } else {
                                root.selectedLive = false
                                root.selectedLeaf = modelData.leaf
                            }
                        }
                    }
                    StyledText {
                        anchors.centerIn: parent
                        width: sourceList.width
                        horizontalAlignment: Text.AlignHCenter
                        wrapMode: Text.Wrap
                        visible: sourceList.count === 0
                        text: root.catalogLoaded ? "No image catalog found." : "Loading images…"
                        color: Theme.surfaceVariantText
                    }
                }

                StyledText {
                    text: root.catalogError
                    visible: text !== ""
                    color: Theme.warning
                    font.pixelSize: Theme.fontSizeSmall
                    wrapMode: Text.Wrap
                    Layout.fillWidth: true
                }

                Item { Layout.fillHeight: true }

                RowLayout {
                    Layout.fillWidth: true
                    DankButton { text: "Back"; tonal: true; onClicked: root.back() }
                    Item { Layout.fillWidth: true }
                    DankButton {
                        text: "Continue"
                        enabled: root.sourceReady && root.catalogLoaded
                        onClicked: root.chooseAndNext()
                    }
                }
            }

            // Page 3: Disk selection — a grouped list of DankListItems.
            ColumnLayout {
                spacing: Theme.spacingM

                StyledText {
                    text: "Destination"
                    font.pixelSize: Theme.fontSizeXLarge
                    font.weight: Theme.fontWeightMedium
                }
                StyledText {
                    text: root.text(root.selectedDisk.removable ? "confirm_warning_removable" : "confirm_warning", { disk: root.selectedDisk.path !== undefined
                        ? root.selectedDisk.path : "the selected disk" })
                    color: Theme.warning
                    Layout.fillWidth: true
                }

                ListView {
                    id: diskList
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    model: root.disks
                    clip: true
                    spacing: Theme.groupedListGap
                    delegate: DankListItem {
                        required property var modelData
                        required property int index
                        width: diskList.width
                        firstInGroup: index === 0
                        lastInGroup: index === diskList.count - 1
                        // fisherman's disk (shared/probe/README.md): the model
                        // (the path when unknown), then path, size label, bus.
                        primaryText: modelData.title
                        secondaryText: [modelData.path, modelData.size_label, modelData.transport_label]
                            .filter(s => s).join("  ·  ")
                        isSelected: root.selectedDisk.path === modelData.path
                        onClicked: root.selectedDisk = modelData
                    }
                    StyledText {
                        anchors.centerIn: parent
                        width: diskList.width
                        horizontalAlignment: Text.AlignHCenter
                        wrapMode: Text.Wrap
                        visible: diskList.count === 0
                        text: root.diskError !== ""
                            ? "Could not detect disks: " + root.diskError
                            : root.disksProbed
                                ? "No disk of at least 50 GiB was found. Connect one to install to."
                                : "Scanning for disks…"
                        color: Theme.surfaceVariantText
                    }
                }

                RowLayout {
                    Layout.fillWidth: true
                    DankButton { text: "Back"; tonal: true; onClicked: root.back() }
                    Item { Layout.fillWidth: true }
                    DankButton {
                        text: "Continue"
                        enabled: root.selectedDisk.path !== undefined
                        onClicked: root.advance()
                    }
                }
            }

            // Page 4: Encryption — a grouped list of choices, a card of fields.
            //
            // Options mirror tuna-installer-xfce's ENCRYPTION_CHOICES, which is
            // the reference implementation — same values, same wording, so the
            // frontends describe the same choice identically. The tpm2 options
            // are omitted entirely when the backend reports no TPM, rather than
            // shown and then failing at install time.
            ColumnLayout {
                id: encryptionPage
                spacing: Theme.spacingM

                function next() {
                    // fisherman's rules (an empty passphrase) come from
                    // `validate`; that the two entries match is this page's.
                    root.passphrase = passField.text
                    if (root.encryptionProblem !== "" || root.filesystemProblem !== "") return
                    if (root.needsPassphrase(root.encType) && passField.text !== passConfirm.text) {
                        passError.text = "Passphrases do not match."
                        return
                    }
                    passError.text = ""
                    root.flowNext()
                }

                StyledText {
                    text: "Disk encryption"
                    font.pixelSize: Theme.fontSizeXLarge
                    font.weight: Theme.fontWeightMedium
                }
                StyledText {
                    text: "Encryption protects your files if the disk is lost or stolen. It cannot be turned on later without reinstalling."
                    color: Theme.surfaceVariantText
                    Layout.fillWidth: true
                }

                ColumnLayout {
                    Layout.fillWidth: true
                    spacing: Theme.groupedListGap
                    Repeater {
                        model: root.offeredEncryptionTypes
                        DankListItem {
                            required property string modelData
                            required property int index
                            Layout.fillWidth: true
                            firstInGroup: index === 0
                            lastInGroup: index === root.offeredEncryptionTypes.length - 1
                            primaryText: root.encryptionText(modelData, "_label")
                            secondaryText: root.encryptionText(modelData, "_description")
                            isSelected: root.encType === modelData
                            onClicked: root.encType = modelData
                        }
                    }
                }

                // Only for a choice with needs_passphrase.
                DankCard {
                    Layout.fillWidth: true
                    visible: root.needsPassphrase(root.encType)
                    title: "Passphrase"
                    Column {
                        width: parent.width
                        spacing: Theme.spacingS
                        DankTextField {
                            id: passField
                            placeholderText: "Enter passphrase"
                            echoMode: TextInput.Password
                            width: Math.min(parent.width, 360)
                            onTextChanged: root.passphrase = text
                        }
                        DankTextField {
                            id: passConfirm
                            placeholderText: "Confirm passphrase"
                            echoMode: TextInput.Password
                            width: Math.min(parent.width, 360)
                            isError: passError.text !== ""
                        }
                        StyledText {
                            id: passError
                            color: Theme.error
                            visible: text !== ""
                            font.pixelSize: Theme.fontSizeSmall
                        }
                        StyledText {
                            text: root.encryptionProblem
                            color: Theme.error
                            visible: text !== ""
                            font.pixelSize: Theme.fontSizeSmall
                        }
                    }
                }

                // Filesystem (XFCE SetupPage Advanced parity): the rows
                // follow the catalog leaf until the user picks one
                // (showFilesystem without fsChosen does not count).
                DankCard {
                    Layout.fillWidth: true
                    title: "Advanced"
                    Column {
                        width: parent.width
                        spacing: Theme.spacingS
                        StyledText {
                            text: root.selectedLeaf && root.selectedLeaf.filesystem
                                ? "Filesystem (from the selected image — change to override)"
                                : "Filesystem"
                            color: Theme.surfaceVariantText
                            font.pixelSize: Theme.fontSizeSmall
                        }
                        ColumnLayout {
                            width: parent.width
                            spacing: Theme.groupedListGap
                            Repeater {
                                model: root.filesystems
                                DankListItem {
                                    required property string modelData
                                    required property int index
                                    Layout.fillWidth: true
                                    firstInGroup: index === 0
                                    lastInGroup: index === root.filesystems.length - 1
                                    primaryText: modelData
                                    monospace: true
                                    isSelected: root.filesystem === modelData
                                    onClicked: {
                                        root.filesystem = modelData
                                        root.fsChosen = true
                                    }
                                }
                            }
                        }
                        DankListItem {
                            width: parent.width
                            visible: root.filesystem === "btrfs"
                            primaryText: "Create btrfs subvolumes (@, @home, @snapshots)"
                            isSelected: root.btrfsSubvolumes
                            onClicked: root.btrfsSubvolumes = !root.btrfsSubvolumes
                        }
                        StyledText {
                            text: root.filesystemProblem
                            color: Theme.error
                            visible: text !== ""
                            font.pixelSize: Theme.fontSizeSmall
                        }
                    }
                }

                Item { Layout.fillHeight: true }

                RowLayout {
                    Layout.fillWidth: true
                    DankButton { text: "Back"; tonal: true; onClicked: root.back() }
                    Item { Layout.fillWidth: true }
                    DankButton { text: "Continue"; onClicked: encryptionPage.next() }
                }
            }

            // Page 5: Account — the user fisherman creates (the recipe's
            // `user` block). The username rules are fisherman's, through
            // `validate`; that the password is set and typed the same twice
            // is this page's. The heading names no screen of the parity
            // contract (shared/walkthrough/parity_report.py).
            ColumnLayout {
                id: accountPage
                spacing: Theme.spacingM

                StyledText {
                    text: "Your account"
                    font.pixelSize: Theme.fontSizeXLarge
                    font.weight: Theme.fontWeightMedium
                }
                StyledText {
                    text: "The account you sign in with. It can administer this computer."
                    color: Theme.surfaceVariantText
                    wrapMode: Text.Wrap
                    Layout.fillWidth: true
                }

                DankCard {
                    Layout.fillWidth: true
                    title: "Account"
                    GridLayout {
                        width: parent.width
                        columns: 2
                        columnSpacing: Theme.spacingXL
                        rowSpacing: Theme.spacingS

                        StyledText { text: "Username"; color: Theme.surfaceVariantText }
                        ColumnLayout {
                            spacing: 2
                            DankTextField {
                                id: userField
                                objectName: "accountUsername"
                                text: root.username
                                onTextEdited: root.username = text
                                font.family: Theme.monoFontFamily
                                implicitWidth: 300
                                isError: root.usernameProblem !== ""
                            }
                            // fisherman's username rule, in the copy's words.
                            StyledText {
                                text: root.usernameProblem
                                color: Theme.error
                                visible: text !== ""
                                font.pixelSize: Theme.fontSizeSmall
                                wrapMode: Text.Wrap
                                Layout.maximumWidth: 300
                            }
                        }

                        StyledText { text: "Full name"; color: Theme.surfaceVariantText }
                        DankTextField {
                            id: fullnameField
                            objectName: "accountFullname"
                            text: root.fullname
                            onTextEdited: root.fullname = text
                            placeholderText: "Optional"
                            implicitWidth: 300
                        }

                        StyledText { text: "Password"; color: Theme.surfaceVariantText }
                        DankTextField {
                            id: userPassField
                            objectName: "accountPassword"
                            text: root.userPassword
                            onTextEdited: root.userPassword = text
                            echoMode: TextInput.Password
                            implicitWidth: 300
                        }

                        StyledText { text: "Password again"; color: Theme.surfaceVariantText }
                        ColumnLayout {
                            spacing: 2
                            DankTextField {
                                id: userPassConfirm
                                objectName: "accountPasswordConfirm"
                                text: root.userPasswordConfirm
                                onTextEdited: root.userPasswordConfirm = text
                                echoMode: TextInput.Password
                                implicitWidth: 300
                                isError: root.userPasswordConfirm !== "" && !root.passwordsMatch
                            }
                            StyledText {
                                text: "Passwords do not match."
                                color: Theme.error
                                visible: root.userPasswordConfirm !== "" && !root.passwordsMatch
                                font.pixelSize: Theme.fontSizeSmall
                            }
                        }
                    }
                }

                Item { Layout.fillHeight: true }

                RowLayout {
                    Layout.fillWidth: true
                    DankButton { text: "Back"; tonal: true; onClicked: root.back() }
                    Item { Layout.fillWidth: true }
                    DankButton {
                        objectName: "accountNextButton"
                        text: "Continue"
                        enabled: root.accountReady
                        onClicked: root.advance()
                    }
                }
            }

            // Page 6: Confirm — the summary on a card, the product's own lines
            // around it, Install in the error tone (it erases a disk).
            ColumnLayout {
                spacing: Theme.spacingM

                StyledText {
                    text: root.text("confirm_title")
                    font.pixelSize: Theme.fontSizeXLarge
                    font.weight: Theme.fontWeightMedium
                }
                StyledText {
                    text: root.text("confirm_subtitle")
                    visible: text !== ""
                    color: Theme.surfaceVariantText
                    font.italic: true
                    Layout.fillWidth: true
                }
                Rectangle {
                    Layout.fillWidth: true
                    radius: Theme.cornerRadiusM
                    color: Theme.withAlpha(Theme.warning, 0.12)
                    implicitHeight: warnText.implicitHeight + Theme.spacingM * 2
                    StyledText {
                        id: warnText
                        anchors { left: parent.left; right: parent.right; verticalCenter: parent.verticalCenter; margins: Theme.spacingM }
                        text: "⚠  " + root.text(root.selectedDisk.removable ? "confirm_warning_removable" : "confirm_warning", { disk: root.selectedDisk.path ? root.selectedDisk.path : "the selected disk" })
                        color: Theme.warning
                    }
                }

                DankCard {
                    Layout.fillWidth: true
                    title: "Summary"
                    GridLayout {
                        width: parent.width
                        columns: 2
                        columnSpacing: Theme.spacingXL
                        rowSpacing: Theme.spacingS
                        StyledText { text: "Target disk"; color: Theme.surfaceVariantText }
                        StyledText { text: root.selectedDisk.path ? root.selectedDisk.path : "—"; isMonospace: true }
                        StyledText { text: "Image"; color: Theme.surfaceVariantText }
                        StyledText {
                            text: root.isLive && root.selectedLive
                                ? (root.liveImage || "this system") + "  (this system, no download)"
                                : (root.selectedLeaf
                                    ? root.selectedLeaf.name + "  (" + root.selectedLeaf.imgref + ")"
                                    : (root.selectedImage || "—"))
                            isMonospace: true
                            font.pixelSize: Theme.fontSizeSmall
                            Layout.fillWidth: true
                        }
                        StyledText { text: "Filesystem"; color: Theme.surfaceVariantText }
                        StyledText {
                            text: root.filesystem + (root.filesystem === "btrfs" && root.btrfsSubvolumes ? "  (subvolumes)" : "")
                            isMonospace: true
                        }
                        StyledText { text: "Encryption"; color: Theme.surfaceVariantText }
                        StyledText { text: root.encryptionText(root.encType, "_label"); isMonospace: true }
                        StyledText { text: "Username"; color: Theme.surfaceVariantText; visible: root.needsUserCreation }
                        StyledText {
                            objectName: "confirmUsername"
                            visible: root.needsUserCreation
                            text: root.username || "—"; isMonospace: true
                        }
                        StyledText { text: "Hostname"; color: Theme.surfaceVariantText }
                        ColumnLayout {
                            spacing: 2
                            DankTextField {
                                id: hostField
                                text: root.hostname
                                onTextEdited: { root.hostnameTouched = true; root.hostname = text }  // not onTextChanged: that fires at load and would pin the branding default
                                font.family: Theme.monoFontFamily
                                implicitWidth: 260
                                isError: root.hostnameProblem !== ""
                            }
                            // fisherman's hostname rule, in the copy's words.
                            StyledText {
                                text: root.hostnameProblem
                                color: Theme.error
                                visible: text !== ""
                                font.pixelSize: Theme.fontSizeSmall
                            }
                        }
                    }
                }

                StyledText {
                    text: root.text("confirm_body")
                    visible: text !== ""
                    color: Theme.surfaceVariantText
                    horizontalAlignment: Text.AlignHCenter
                    Layout.fillWidth: true
                }

                Item { Layout.fillHeight: true }

                RowLayout {
                    Layout.fillWidth: true
                    DankButton { text: "Back"; tonal: true; onClicked: root.back() }
                    Item { Layout.fillWidth: true }
                    DankButton {
                        text: root.text("confirm_button")
                        destructive: true
                        enabled: root.selectedDisk.path !== undefined && root.hostnameProblem === ""
                            && root.filesystemProblem === ""
                            && (!root.needsUserCreation || root.accountReady)
                        onClicked: root.startInstall()
                    }
                }
            }

            // Page 7: Install progress — determinate bar from the [n/9] lines,
            // the log on a card.
            ColumnLayout {
                spacing: Theme.spacingM

                StyledText {
                    text: root.text("progress_title")
                    font.pixelSize: Theme.fontSizeXLarge
                    font.weight: Theme.fontWeightMedium
                }
                StyledText {
                    text: root.installStep > 0
                        ? "Step " + root.installStep + " of " + root.installSteps
                          + (root.installStepName ? " — " + root.installStepName : "")
                        : "Starting…"
                    color: Theme.surfaceVariantText
                }
                Rectangle {
                    Layout.fillWidth: true
                    height: 8; radius: 4
                    color: Theme.surfaceContainerHighest
                    Rectangle {
                        // The capture harness finds this by name and fails
                        // when it is missing, zero-width or unpainted
                        // (tests/gui/capture-screens.py). findChild() cannot
                        // see QML ids, hence an objectName.
                        objectName: "installProgressFill"

                        width: parent.width * root.installFraction
                        height: parent.height; radius: 4
                        color: Theme.primary
                        Behavior on width { NumberAnimation { duration: Theme.mediumDuration; easing.type: Theme.standardEasing } }
                    }
                }

                DankCard {
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    pad: Theme.spacingS
                    ScrollView {
                        anchors.fill: parent
                        clip: true
                        TextArea {
                            text: root.installLog === "" ? "Starting…" : root.installLog
                            font.family: Theme.monoFontFamily
                            font.pixelSize: Theme.fontSizeSmall
                            color: Theme.surfaceText
                            readOnly: true
                            wrapMode: TextEdit.Wrap
                            background: null
                        }
                    }
                }
                StyledText {
                    text: root.text("progress_note")
                    color: Theme.warning
                    font.pixelSize: Theme.fontSizeSmall
                }
                // The persistent install log (dialog_output parity): its
                // path on disk plus a copy of what scrolled past. The
                // in-memory installLog is gone the moment the window
                // closes; this file is what support asks for.
                TextEdit {
                    id: logClip
                    visible: false
                    text: root.installLog
                }
                RowLayout {
                    Layout.fillWidth: true
                    spacing: Theme.spacingM
                    StyledText {
                        text: root.logPath !== "" ? "Log: " + root.logPath : ""
                        visible: text !== ""
                        color: Theme.surfaceVariantText
                        font.pixelSize: Theme.fontSizeSmall
                        isMonospace: true
                        Layout.fillWidth: true
                        wrapMode: Text.Wrap
                    }
                    DankButton {
                        text: "Copy log"
                        tonal: true
                        onClicked: {
                            logClip.selectAll()
                            logClip.copy()
                            logClip.deselect()
                        }
                    }
                    DankButton {
                        objectName: "cancelInstallButton"
                        text: "Cancel"
                        tonal: true
                        visible: installProc.running
                        onClicked: cancelProc.running = true
                    }
                }
            }

            // Page 8: Done
            Item {
                ColumnLayout {
                    anchors.centerIn: parent
                    width: Math.min(parent.width, 520)
                    spacing: Theme.spacingL

                    Rectangle {
                        Layout.alignment: Qt.AlignHCenter
                        width: 96; height: 96; radius: 48
                        color: root.installSuccess ? Theme.withAlpha(Theme.success, 0.2) : Theme.withAlpha(Theme.error, 0.2)
                        Image {
                            id: doneLogo
                            objectName: "doneBrandingLogo"
                            anchors.centerIn: parent
                            width: 56; height: 56
                            source: root.installSuccess ? root.productLogo : ""
                            visible: root.installSuccess && status === Image.Ready
                            fillMode: Image.PreserveAspectFit
                        }
                        StyledText {
                            visible: !doneLogo.visible
                            anchors.centerIn: parent
                            text: root.installSuccess ? "✓" : "✗"
                            font.pixelSize: 48
                            color: root.installSuccess ? Theme.success : Theme.error
                        }
                    }
                    StyledText {
                        text: root.installSuccess ? root.text("done_title") : root.text("done_failed_title")
                        font.pixelSize: Theme.fontSizeXXLarge
                        font.weight: Theme.fontWeightMedium
                        horizontalAlignment: Text.AlignHCenter
                        Layout.fillWidth: true
                    }
                    StyledText {
                        text: root.installSuccess
                            ? root.text("done_subtitle")
                            : "Check the installation log for details."
                        color: Theme.surfaceVariantText
                        horizontalAlignment: Text.AlignHCenter
                        Layout.fillWidth: true
                    }
                    // store_label -> store_url: on every frontend when the
                    // branding sets a store (docs/PARITY.md).
                    StyledText {
                        visible: root.installSuccess && root.storeUrl !== ""
                        text: "<a href=\"" + root.storeUrl + "\">" + root.text("store_label") + "</a>"
                        textFormat: Text.RichText
                        linkColor: Theme.primary
                        horizontalAlignment: Text.AlignHCenter
                        Layout.fillWidth: true
                        onLinkActivated: link => Qt.openUrlExternally(link)
                    }
                    // Recovery key (#129). A panel rather than a dialog, as
                    // on the other frontends: a dialog is dismissed and then
                    // the key is gone, while this stays on screen for as long
                    // as it takes to write down.
                    ColumnLayout {
                        visible: root.installSuccess && root.recoveryKey !== ""
                        Layout.fillWidth: true
                        Layout.topMargin: Theme.spacingM
                        spacing: Theme.spacingS
                        StyledText {
                            text: root.text("recovery_key_title")
                            font.pixelSize: Theme.fontSizeLarge
                            font.weight: Theme.fontWeightMedium
                            horizontalAlignment: Text.AlignHCenter
                            Layout.fillWidth: true
                        }
                        StyledText {
                            text: root.text("recovery_key_body")
                            color: Theme.surfaceVariantText
                            wrapMode: Text.WordWrap
                            horizontalAlignment: Text.AlignHCenter
                            Layout.fillWidth: true
                        }
                        StyledText {
                            objectName: "recoveryKeyLabel"
                            text: root.recoveryKey
                            font.family: Theme.monoFontFamily
                            horizontalAlignment: Text.AlignHCenter
                            Layout.fillWidth: true
                        }
                        // Plain Qt Quick has no clipboard object; a hidden
                        // TextEdit is the standard way to reach one.
                        TextEdit {
                            id: recoveryClip
                            visible: false
                            text: root.recoveryKey
                        }
                        RowLayout {
                            Layout.alignment: Qt.AlignHCenter
                            spacing: Theme.spacingM
                            DankButton {
                                text: root.text("recovery_key_copy")
                                tonal: true
                                onClicked: {
                                    recoveryClip.selectAll()
                                    recoveryClip.copy()
                                    recoveryClip.deselect()
                                }
                            }
                            DankButton {
                                objectName: "recoveryAckButton"
                                text: (root.recoveryAck ? "\u2713  " : "")
                                    + root.text("recovery_key_ack")
                                tonal: !root.recoveryAck
                                checkable: true
                                checked: root.recoveryAck
                                onToggled: root.recoveryAck = checked
                            }
                        }
                    }
                    // Tour (views/tour.py parity): the leaf's carousel, if it
                    // ships one. A panel would strand the slides after the
                    // window closes; the overlay keeps Close one tap away.
                    // The phone companion stays GNOME-only (see below).
                    DankButton {
                        Layout.alignment: Qt.AlignHCenter
                        text: "Take a tour"
                        tonal: true
                        visible: root.installSuccess && root.tourSlides.length > 0
                        onClicked: { root.tourIndex = 0; root.tourOpen = true }
                    }
                    RowLayout {
                        Layout.alignment: Qt.AlignHCenter
                        spacing: Theme.spacingM
                        DankButton { text: "Close"; tonal: true; onClicked: Qt.quit() }
                        DankButton {
                            text: "Power off"
                            tonal: true
                            visible: root.installSuccess
                            onClicked: root.powerOpen = true
                        }
                        DankButton {
                            objectName: "doneRestartButton"
                            text: root.text("done_restart")
                            visible: root.installSuccess
                            // Held until the key is acknowledged.
                            enabled: !root.recoveryKeyPending
                            onClicked: rebootProc.running = true
                        }
                    }
                }
            }
        }

        // Hint bar: the keybindings, the way a niri user expects from their bar.
        RowLayout {
            Layout.fillWidth: true
            spacing: Theme.spacingL
            visible: root.currentPage <= 6
            Repeater {
                model: [
                    { key: "Enter", what: root.currentPage === 6 ? root.text("confirm_button") : "Continue" },
                    { key: "Shift+Enter", what: "Back" },
                    { key: "Tab", what: "Next field" }
                ]
                RowLayout {
                    required property var modelData
                    spacing: Theme.spacingXS
                    visible: !(modelData.key === "Shift+Enter" && root.currentPage === 0)
                    Rectangle {
                        radius: Theme.cornerRadiusXS
                        color: Theme.surfaceContainerHigh
                        implicitWidth: keyText.implicitWidth + Theme.spacingS * 2
                        implicitHeight: keyText.implicitHeight + Theme.spacingXS * 2
                        StyledText {
                            id: keyText
                            anchors.centerIn: parent
                            text: modelData.key
                            isMonospace: true
                            font.pixelSize: Theme.fontSizeSmall
                            color: Theme.surfaceVariantText
                        }
                    }
                    StyledText {
                        text: modelData.what
                        font.pixelSize: Theme.fontSizeSmall
                        color: Theme.surfaceVariantText
                    }
                }
            }
            Item { Layout.fillWidth: true }
        }
    }
    // Requirements gate overlay (window_cpu/window_ram/window_unsupported
    // parity). An unmet requirement blocks the welcome page: RAM/CPU
    // offer "Continue anyway" (the Ignore path the GTK gates relaunch
    // with); UEFI offers no continue — only power off or the firmware
    // setup that fixes it.
    Rectangle {
        anchors.fill: parent
        visible: root.gateOpen
        color: Theme.withAlpha(Theme.surface, 0.75)
        z: 10
        MouseArea { anchors.fill: parent }
        DankCard {
            anchors.centerIn: parent
            width: Math.min(parent.width - Theme.spacingXL * 2, 520)
            title: root.text("requirements_title")
            Column {
                width: parent.width
                spacing: Theme.spacingM
                StyledText {
                    text: root.requirementsWarning.split("\n").slice(1).join("\n")
                    color: Theme.warning
                    wrapMode: Text.Wrap
                    width: parent.width
                }
                RowLayout {
                    width: parent.width
                    spacing: Theme.spacingM
                    Item { Layout.fillWidth: true }
                    DankButton {
                        visible: !root.gateUefi
                        text: "Continue anyway"
                        onClicked: root.gatesAccepted = true
                    }
                    DankButton {
                        visible: root.gateUefi
                        text: "Firmware setup"
                        onClicked: firmwareProc.running = true
                    }
                    DankButton {
                        text: "Power off"
                        tonal: true
                        onClicked: root.powerOpen = true
                    }
                }
            }
        }
    }

    // Power dialog overlay (dialog_poweroff parity): the host is
    // rebooted or powered off through systemctl, never in this
    // runtime. The firmware row only exists on UEFI, the same
    // condition BootcPoweroffDialog checks with Systeminfo.is_uefi().
    Rectangle {
        anchors.fill: parent
        visible: root.powerOpen
        color: Theme.withAlpha(Theme.surface, 0.75)
        z: 11
        MouseArea { anchors.fill: parent; onClicked: root.powerOpen = false }
        DankCard {
            anchors.centerIn: parent
            width: Math.min(parent.width - Theme.spacingXL * 2, 420)
            title: "Power"
            ColumnLayout {
                width: parent.width
                spacing: Theme.groupedListGap
                DankListItem {
                    Layout.fillWidth: true
                    firstInGroup: true
                    lastInGroup: root.gateUefi
                    primaryText: "Power off"
                    secondaryText: "Shut down this computer"
                    onClicked: poweroffProc.running = true
                }
                DankListItem {
                    Layout.fillWidth: true
                    firstInGroup: false
                    lastInGroup: !root.gateUefi
                    primaryText: "Restart"
                    secondaryText: "Restart this computer"
                    onClicked: rebootProc.running = true
                }
                DankListItem {
                    Layout.fillWidth: true
                    visible: !root.gateUefi
                    firstInGroup: false
                    lastInGroup: true
                    primaryText: "Firmware setup"
                    secondaryText: "Reboot into the firmware settings"
                    onClicked: firmwareProc.running = true
                }
                DankButton {
                    Layout.alignment: Qt.AlignHCenter
                    Layout.topMargin: Theme.spacingS
                    text: "Close"
                    tonal: true
                    onClicked: root.powerOpen = false
                }
            }
        }
    }

    // Tour overlay (views/tour.py parity): the selected leaf's
    // carousel slides, or nothing — the done page hides its button
    // when the catalog ships no artwork.
    //
    // Deliberately not covered: the phone companion
    // (utils/phone_companion.py). It needs an HTTP server, a QR
    // encoder and credential injection into the recipe, none of which
    // this thin QML layer has — and PARITY.md keeps it GNOME-only by
    // design, with no fisherman rule to back it.
    Rectangle {
        anchors.fill: parent
        visible: root.tourOpen && root.tourSlides.length > 0
        color: Theme.withAlpha(Theme.surface, 0.85)
        z: 12
        MouseArea { anchors.fill: parent }
        DankCard {
            anchors.centerIn: parent
            width: Math.min(parent.width - Theme.spacingXL * 2, 560)
            title: {
                const slide = root.tourSlides[Math.min(root.tourIndex, root.tourSlides.length - 1)] || {}
                return slide.title || ("Slide " + (root.tourIndex + 1) + " of " + root.tourSlides.length)
            }
            Column {
                width: parent.width
                spacing: Theme.spacingM
                Image {
                    width: parent.width
                    height: 240
                    fillMode: Image.PreserveAspectFit
                    source: {
                        const slide = root.tourSlides[Math.min(root.tourIndex, root.tourSlides.length - 1)] || {}
                        return slide.image || ""
                    }
                    visible: status === Image.Ready
                }
                StyledText {
                    text: {
                        const slide = root.tourSlides[Math.min(root.tourIndex, root.tourSlides.length - 1)] || {}
                        return slide.description || ""
                    }
                    visible: text !== ""
                    color: Theme.surfaceVariantText
                    wrapMode: Text.Wrap
                    width: parent.width
                }
                RowLayout {
                    width: parent.width
                    spacing: Theme.spacingM
                    DankButton {
                        text: "‹"
                        tonal: true
                        enabled: root.tourIndex > 0
                        onClicked: root.tourIndex = Math.max(0, root.tourIndex - 1)
                    }
                    Item { Layout.fillWidth: true }
                    StyledText {
                        text: (root.tourIndex + 1) + " / " + root.tourSlides.length
                        color: Theme.surfaceVariantText
                        font.pixelSize: Theme.fontSizeSmall
                    }
                    Item { Layout.fillWidth: true }
                    DankButton {
                        text: "›"
                        tonal: true
                        enabled: root.tourIndex < root.tourSlides.length - 1
                        onClicked: root.tourIndex = Math.min(root.tourSlides.length - 1, root.tourIndex + 1)
                    }
                }
                DankButton {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: "Close"
                    tonal: true
                    onClicked: root.tourOpen = false
                }
            }
        }
    }

}
