{
  "app-id": "org.tunaos.InstallerNiri",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.9",
  "sdk": "org.kde.Sdk",
  "command": "tuna-installer-niri",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--device=all",
    "--filesystem=host",
    "--talk-name=org.freedesktop.Flatpak",
    "--system-talk-name=org.freedesktop.PolicyKit1"
  ],
  "build-options": {
    "env": {
      "GOPATH": "/run/build/go-path",
      "GOCACHE": "/run/build/go-cache",
      "GOPROXY": "off",
      "GOTOOLCHAIN": "local"
    }
  },
  "modules": [
    {
      "name": "go",
      "buildsystem": "simple",
      "build-commands": ["cp -r go /app/go"],
      "sources": [
        {
          "type": "archive",
          "url": "https://go.dev/dl/go1.26.1.linux-amd64.tar.gz",
          "sha256": "031f088e5d955bab8657ede27ad4e3bc5b7c1ba281f05f245bcc304f327c987a",
          "strip-components": 0,
          "only-arches": ["x86_64"]
        },
        {
          "type": "archive",
          "url": "https://go.dev/dl/go1.26.1.linux-arm64.tar.gz",
          "sha256": "a290581cfe4fe28ddd737dde3095f3dbeb7f2e4065cab4eae44dfc53b760c2f7",
          "strip-components": 0,
          "only-arches": ["aarch64"]
        }
      ]
    },
    {
      "name": "fisherman",
      "buildsystem": "simple",
      "build-commands": [
        "PATH=/app/go/bin:$PATH go build -C fisherman -o /app/bin/fisherman ./cmd/fisherman",
        "install -Dm644 data/images.json /app/share/fisherman/data/images.json",
        "cp -r data/images /app/share/fisherman/data/images",
        "install -Dm644 data/polkit/org.tunaos.Installer.policy /app/share/polkit-1/actions/org.tunaos.Installer.policy"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/tuna-os/fisherman.git",
          "commit": "027fa25c1d8bc01e2ac97d119cda9e8bb9c99ac7"
        }
      ]
    },
    {
      "name": "cli11",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCLI11_BUILD_TESTS=OFF",
        "-DCLI11_BUILD_EXAMPLES=OFF",
        "-DCLI11_BUILD_DOCS=OFF"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/CLIUtils/CLI11.git",
          "tag": "v2.4.2"
        }
      ]
    },
    {
      "name": "quickshell",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCRASH_REPORTER=OFF",
        "-DUSE_JEMALLOC=OFF",
        "-DSERVICE_PIPEWIRE=OFF",
        "-DSERVICE_MPRIS=OFF",
        "-DSERVICE_PAM=OFF",
        "-DSERVICE_GREETD=OFF",
        "-DHYPRLAND=OFF",
        "-DI3=OFF",
        "-DX11=OFF",
        "-DSCREENCOPY=OFF"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://git.outfoxxed.me/quickshell/quickshell.git",
          "tag": "v0.1.0"
        }
      ]
    },
    {
      "name": "tuna-installer-niri",
      "buildsystem": "simple",
      "build-commands": [
        "PATH=/app/go/bin:$PATH go build -C installer -o /app/bin/tuna-installer-backend .",
        "mkdir -p /app/share/tuna-installer-niri",
        "cp -r ui /app/share/tuna-installer-niri/ui",
        "printf '#!/bin/sh\\nexec quickshell -p /app/share/tuna-installer-niri/ui/installer.qml \"$@\"\\n' > /app/bin/tuna-installer-niri",
        "chmod 755 /app/bin/tuna-installer-niri",
        "install -Dm644 data/org.tunaos.InstallerNiri.desktop /app/share/applications/org.tunaos.InstallerNiri.desktop",
        "install -Dm644 data/org.tunaos.InstallerNiri.metainfo.xml /app/share/metainfo/org.tunaos.InstallerNiri.metainfo.xml",
        "install -Dm644 data/icons/hicolor/scalable/apps/org.tunaos.InstallerNiri.svg /app/share/icons/hicolor/scalable/apps/org.tunaos.InstallerNiri.svg"
      ],
      "sources": [{ "type": "dir", "path": ".." }]
    }
  ]
}
