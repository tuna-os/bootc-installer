{
  "app-id": "org.tunaos.InstallerNiri",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.11",
  "sdk": "org.kde.Sdk",
  "command": "tuna-installer-niri",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--device=all",
    "--filesystem=host",
    "--talk-name=org.freedesktop.Flatpak",
    "--system-talk-name=org.freedesktop.PolicyKit1"
  ],
  "build-options": {
    "env": {
      "GOPATH": "/run/build/go-path",
      "GOCACHE": "/run/build/go-cache",
      "GOPROXY": "off",
      "GOTOOLCHAIN": "local"
    }
  },
  "modules": [
    "../../../shared/flatpak/go.json",
    "../../../shared/flatpak/fisherman.json",
    {
      "name": "cli11",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCLI11_BUILD_TESTS=OFF",
        "-DCLI11_BUILD_EXAMPLES=OFF",
        "-DCLI11_BUILD_DOCS=OFF"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/CLIUtils/CLI11.git",
          "tag": "v2.4.2"
        }
      ]
    },
    {
      "name": "quickshell",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCRASH_REPORTER=OFF",
        "-DUSE_JEMALLOC=OFF",
        "-DSERVICE_PIPEWIRE=OFF",
        "-DSERVICE_MPRIS=OFF",
        "-DSERVICE_PAM=OFF",
        "-DSERVICE_GREETD=OFF",
        "-DHYPRLAND=OFF",
        "-DI3=OFF",
        "-DX11=OFF",
        "-DSCREENCOPY=OFF"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://git.outfoxxed.me/quickshell/quickshell.git",
          "tag": "v0.2.1"
        }
      ]
    },
    {
      "name": "tuna-installer-niri-translations",
      "buildsystem": "cmake-ninja",
      "subdir": "translations",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_TESTING=OFF"
      ],
      "sources": [{ "type": "dir", "path": ".." }]
    },
    {
      "name": "tuna-installer-niri",
      "buildsystem": "simple",
      "build-commands": [
        "PATH=/app/go/bin:$PATH go build -C installer -o /app/bin/tuna-installer-backend .",
        "mkdir -p /app/share/tuna-installer-niri",
        "cp -r ui /app/share/tuna-installer-niri/ui",
        "printf '#!/bin/sh\\nexport QML_IMPORT_PATH=/app/lib/tuna-installer-niri/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}\\nexec quickshell -p /app/share/tuna-installer-niri/ui/installer.qml \"$@\"\\n' > /app/bin/tuna-installer-niri",
        "chmod 755 /app/bin/tuna-installer-niri",
        "install -Dm644 data/org.tunaos.InstallerNiri.desktop /app/share/applications/org.tunaos.InstallerNiri.desktop",
        "install -Dm644 data/org.tunaos.InstallerNiri.metainfo.xml /app/share/metainfo/org.tunaos.InstallerNiri.metainfo.xml",
        "install -Dm644 data/icons/hicolor/scalable/apps/org.tunaos.InstallerNiri.svg /app/share/icons/hicolor/scalable/apps/org.tunaos.InstallerNiri.svg"
      ],
      "sources": [{ "type": "dir", "path": ".." }]
    }
  ]
}
